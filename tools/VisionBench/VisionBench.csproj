<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Regression bench for Sts2Overlay.Vision: runs the recogniser over real captures and scores it against the
    run save (map_point_history card_choices) and an optional manual labels file. Also hosts the art-database
    build command and a few diagnostics (replaces the M0 tools/VisionSpike prototype).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sts2Overlay.Vision\Sts2Overlay.Vision.csproj" />
    <!-- DataVersionSelector: the default data version, the same rule the app uses. -->
    <ProjectReference Include="..\..\src\Sts2Overlay.Resources\Sts2Overlay.Resources.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The overlay's badge placement math (WPF-free), shared by the offline `preview` renderer. -->
    <Compile Include="..\..\src\Sts2Overlay.App\Views\BadgeLayout.cs" Link="Shared\BadgeLayout.cs" />
  </ItemGroup>
</Project>
