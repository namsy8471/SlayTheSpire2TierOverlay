<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Sts2Sim.Core grants InternalsVisibleTo("SimFuzz"). Using that assembly name gives this
         offline harness the internal combat-setup API (encounter slots, card-selection source,
         card/enchantment construction) without modifying the simulator. -->
    <AssemblyName>SimFuzz</AssemblyName>
    <RootNamespace>SimTrial</RootNamespace>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <DefaultItemExcludes>$(DefaultItemExcludes);ext/**;out/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="ext\sts2-sim\src\Sts2Sim.Core\Sts2Sim.Core.csproj" />
  </ItemGroup>

</Project>
