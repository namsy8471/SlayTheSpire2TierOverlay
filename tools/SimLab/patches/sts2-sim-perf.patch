@@ -0,0 +1,167 @@
+using System.Collections.Concurrent;
+using System.Reflection;
+using Sts2Sim.Core.Combat;
+using Sts2Sim.Core.Entities.Players;
+using Sts2Sim.Core.Models;
+using Sts2Sim.Core.Runs;
+
+namespace Sts2Sim.Core.Hooks;
+
+/// <summary>
+/// SimLab perf patch. Pure query hooks (no await, no InvokeExecutionFinished, neutral base
+/// method) only need the listeners whose runtime type overrides that hook: for any other
+/// listener the base method returns the neutral value (true, 0, 1, the input, MaxValue) and
+/// has no side effect, so skipping it cannot change a result. The listener order and the
+/// per-dispatch eligibility check stay as in the original loops.
+/// </summary>
+internal static class HookQueryFilter
+{
+    internal enum Slot
+    {
+        ShouldPlay,
+        ShouldAllowHitting,
+        DamageAdditive,
+        DamageMultiplicative,
+        DamageCap,
+        BlockAdditive,
+        BlockMultiplicative,
+        HpLostBeforeOsty,
+        HpLostBeforeOstyLate,
+        HpLostAfterOsty,
+        HpLostAfterOstyLate,
+        CardPlayCount,
+        CardPlayResultLocation,
+        // Not dispatch slots: RunState asks whether a map hook has any listener (lazy act maps).
+        MapGenerated,
+        MapGeneratedLate,
+        AfterMapGenerated,
+        Count,
+    }
+
+    private static readonly MethodInfo[] BaseSlots = new MethodInfo[(int)Slot.Count];
+    private static readonly ConcurrentDictionary<Type, int> Coverage = new();
+    private static readonly Func<AbstractModel, bool>[] Predicates = new Func<AbstractModel, bool>[(int)Slot.Count];
+
+    static HookQueryFilter()
+    {
+        Set(Slot.ShouldPlay, nameof(AbstractModel.ShouldPlay));
+        Set(Slot.ShouldAllowHitting, nameof(AbstractModel.ShouldAllowHitting));
+        Set(Slot.DamageAdditive, nameof(AbstractModel.ModifyDamageAdditive));
+        Set(Slot.DamageMultiplicative, nameof(AbstractModel.ModifyDamageMultiplicative));
+        Set(Slot.DamageCap, nameof(AbstractModel.ModifyDamageCap));
+        Set(Slot.BlockAdditive, nameof(AbstractModel.ModifyBlockAdditive));
+        Set(Slot.BlockMultiplicative, nameof(AbstractModel.ModifyBlockMultiplicative));
+        Set(Slot.HpLostBeforeOsty, nameof(AbstractModel.ModifyHpLostBeforeOsty));
+        Set(Slot.HpLostBeforeOstyLate, nameof(AbstractModel.ModifyHpLostBeforeOstyLate));
+        Set(Slot.HpLostAfterOsty, nameof(AbstractModel.ModifyHpLostAfterOsty));
+        Set(Slot.HpLostAfterOstyLate, nameof(AbstractModel.ModifyHpLostAfterOstyLate));
+        Set(Slot.CardPlayCount, nameof(AbstractModel.ModifyCardPlayCount));
+        Set(Slot.CardPlayResultLocation, nameof(AbstractModel.ModifyCardPlayResultLocation));
+        Set(Slot.MapGenerated, nameof(AbstractModel.ModifyGeneratedMap));
+        Set(Slot.MapGeneratedLate, nameof(AbstractModel.ModifyGeneratedMapLate));
+        Set(Slot.AfterMapGenerated, nameof(AbstractModel.AfterMapGenerated));
+        for (int i = 0; i < (int)Slot.Count; i++)
+        {
+            int bit = 1 << i;
+            Predicates[i] = model => (CoverageOf(model.GetType()) & bit) != 0;
+        }
+    }
+
+    private static void Set(Slot slot, string name)
+    {
+        MethodInfo[] candidates = typeof(AbstractModel)
+            .GetMethods(BindingFlags.Instance | BindingFlags.Public | BindingFlags.DeclaredOnly)
+            .Where(m => m.Name == name && m.IsVirtual).ToArray();
+        if (candidates.Length != 1)
+            throw new InvalidOperationException($"HookQueryFilter: expected one virtual {name}, found {candidates.Length}.");
+        BaseSlots[(int)slot] = candidates[0];
+    }
+
+    internal static bool Overrides(AbstractModel model, Slot slot) => Predicates[(int)slot](model);
+
+    private const int MapHookBits =
+        (1 << (int)Slot.MapGenerated) | (1 << (int)Slot.MapGeneratedLate) | (1 << (int)Slot.AfterMapGenerated);
+
+    /// <summary>Whether the model overrides any map-generation hook (unknown types count as yes).</summary>
+    internal static bool OverridesMapHooks(AbstractModel model) => (CoverageOf(model.GetType()) & MapHookBits) != 0;
+
+    private static int CoverageOf(Type type) => Coverage.GetOrAdd(type, static t => Resolve(t));
+
+    // Same resolution as HookOverrideIndex: walk the type chain to the most derived declaration
+    // of each slot; a slot counts as overridden unless that declaration is the base method.
+    // Any reflection failure keeps every listener (fail-open).
+    private static int Resolve(Type runtimeType)
+    {
+        int all = (1 << (int)Slot.Count) - 1;
+        try
+        {
+            int coverage = 0;
+            for (int index = 0; index < BaseSlots.Length; index++)
+            {
+                MethodInfo baseSlot = BaseSlots[index];
+                bool resolved = false;
+                for (Type? current = runtimeType; current is not null && !resolved; current = current.BaseType)
+                {
+                    foreach (MethodInfo method in current.GetMethods(BindingFlags.Instance |
+                        BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.DeclaredOnly))
+                    {
+                        if (!method.IsVirtual || method.GetBaseDefinition() != baseSlot) continue;
+                        if (method != baseSlot) coverage |= 1 << index;
+                        resolved = true;
+                        break;
+                    }
+                }
+                if (!resolved) coverage |= 1 << index;
+            }
+            return coverage;
+        }
+        catch (Exception error) when (error is not OutOfMemoryException and not AccessViolationException)
+        {
+            return all;
+        }
+    }
+
+    /// <summary>
+    /// The listeners <c>runState.IterateHookListeners(combatState)</c> would yield, in the same
+    /// order, minus those that do not override <paramref name="slot"/>. Null when this shortcut
+    /// does not apply (unknown run/combat state types, no combat, malformed sources): the caller
+    /// then runs its original loop.
+    /// </summary>
+    internal static AbstractModel[]? Listeners(IRunState runState, ICombatState? combatState, Slot slot)
+    {
+        if (combatState is not CombatState concrete) return null;
+        if (!CombatState.HasStandardRunListeners(runState)) return null;
+        AbstractModel[]? combat = concrete.FilteredCombatListeners((int)slot, (int)Slot.Count, Predicates[(int)slot]);
+        if (combat is null) return null;
+
+        // Relics (not melted) then potions per player, as both run-state iterators yield them.
+        List<AbstractModel>? inventory = null;
+        IReadOnlyList<Player> players = runState.Players;
+        for (int i = 0; i < players.Count; i++)
+        {
+            Player player = players[i];
+            // Indexed loops: foreach over the IReadOnlyList interface boxes an enumerator per call.
+            IReadOnlyList<RelicModel> relics = player.Relics;
+            for (int r = 0; r < relics.Count; r++)
+            {
+                RelicModel relic = relics[r];
+                if (!relic.IsMelted && Overrides(relic, slot)) (inventory ??= new List<AbstractModel>()).Add(relic);
+            }
+            IReadOnlyList<PotionModel?> potions = player.PotionSlots;
+            for (int q = 0; q < potions.Count; q++)
+                if (potions[q] is { } potion && Overrides(potion, slot)) (inventory ??= new List<AbstractModel>()).Add(potion);
+        }
+        if (inventory is null) return combat;
+        inventory.AddRange(combat);
+        return inventory.ToArray();
+    }
+
+    /// <summary>Same as <see cref="Listeners"/> for loops over <c>IterateCombatHookListeners</c>,
+    /// which yield nothing once the combat is over or ending (and not starting).</summary>
+    internal static AbstractModel[]? CombatListeners(ICombatState combatState, Slot slot)
+    {
+        if (combatState is not CombatState) return null;
+        if (combatState.IsOverOrEnding() && !combatState.IsStarting()) return Array.Empty<AbstractModel>();
+        return Listeners(combatState.RunState, combatState, slot);
+    }
+}
