+        AbstractModel[]? filtered = combat.FilteredCombatListeners(slot, out AbstractModel[]? all);
+        if (filtered is null)
+        {
+            // Malformed sources: the original combat part (it rebuilds the list the old way).
+            foreach (AbstractModel listener in combat.IterateHookListeners()) yield return listener;
+            yield break;
+        }
+        if (Check) CheckCombat(combat, all!, filtered, slot);
+        for (int k = 0; k < filtered.Length; k++)
+        {
+            if (AbstractModel.ExecutionFinishedSubscribed)
+            {
+                for (int t = NextPosition(all!, filtered, k); t < all!.Length; t++) yield return all[t];
+                yield break;
+            }
+            yield return filtered[k];
+        }
+        if (AbstractModel.ExecutionFinishedSubscribed)
+        {
+            for (int t = NextPosition(all!, filtered, filtered.Length); t < all!.Length; t++) yield return all[t];
+        }
+    }
+
+    // The materialized form: everything the original ToArray() reads is read now; the walk
+    // yields the kept part of that fixed snapshot. The full inventory is kept only when some of
+    // it overrides (otherwise nothing of it is yielded, so it can never be needed).
+    private static IEnumerable<AbstractModel>? Snapshot(IRunState runState, CombatState combat, int slot)
+    {
+        List<Player> players = (List<Player>)runState.Players;
+        int count = 0;
+        bool any = false;
+        for (int i = 0; i < players.Count; i++)
+        {
+            IReadOnlyList<RelicModel> relics = players[i].Relics;
+            for (int r = 0; r < relics.Count; r++)
+            {
+                if (relics[r].IsMelted) continue;
+                count++;
+                any |= Overrides(relics[r], slot);
+            }
+            IReadOnlyList<PotionModel?> potions = players[i].PotionSlots;
+            for (int q = 0; q < potions.Count; q++)
+            {
+                if (potions[q] is not { } potion) continue;
+                count++;
+                any |= Overrides(potion, slot);
+            }
+        }
+        AbstractModel[]? inventory = null;
+        if (any)
+        {
+            inventory = new AbstractModel[count];
+            int n = 0;
+            for (int i = 0; i < players.Count; i++)
+            {
+                IReadOnlyList<RelicModel> relics = players[i].Relics;
+                for (int r = 0; r < relics.Count; r++)
+                    if (!relics[r].IsMelted) inventory[n++] = relics[r];
+                IReadOnlyList<PotionModel?> potions = players[i].PotionSlots;
+                for (int q = 0; q < potions.Count; q++)
+                    if (potions[q] is { } potion) inventory[n++] = potion;
+            }
+        }
+        AbstractModel[]? filtered = combat.FilteredCombatListeners(slot, out AbstractModel[]? all);
+        if (filtered is null) return null;
+        if (Check) CheckSnapshot(runState, combat, inventory, filtered, slot);
+        if (inventory is null && filtered.Length == 0) return Array.Empty<AbstractModel>();
+        return WalkSnapshot(inventory, all!, filtered, slot);
+    }
+
+    private static IEnumerable<AbstractModel> WalkSnapshot(
+        AbstractModel[]? inventory, AbstractModel[] all, AbstractModel[] filtered, int slot)
+    {
+        if (inventory is not null)
+        {
+            for (int i = 0; i < inventory.Length; i++)
+                if (Keep(inventory[i], slot)) yield return inventory[i];
+        }
+        for (int k = 0; k < filtered.Length; k++)
+        {
+            if (AbstractModel.ExecutionFinishedSubscribed)
+            {
+                for (int t = NextPosition(all, filtered, k); t < all.Length; t++) yield return all[t];
+                yield break;
+            }
+            yield return filtered[k];
+        }
+        if (AbstractModel.ExecutionFinishedSubscribed)
+        {
+            for (int t = NextPosition(all, filtered, filtered.Length); t < all.Length; t++) yield return all[t];
+        }
+    }
+
+    // ---- Stand-in for IterateDirectCombatHookListeners (BuildHookListeners(true), eager) ----
+
+    /// <summary>
+    /// Filtered stand-in for <c>IterateDirectCombatHookListeners(combatState)</c> and its
+    /// <c>ToArray()</c>: per creature its powers, then (active player) its unmelted relics and
+    /// potions, then monster or orbs and piles; all read now, as the original builds the whole
+    /// array at the call. Null: original.
+    /// </summary>
+    internal static IEnumerable<AbstractModel>? Direct(ICombatState combatState, int slot)
+    {
+        if (combatState is not CombatState concrete || AbstractModel.ExecutionFinishedSubscribed) return null;
+        if (!concrete.DirectCombatListeners(slot, out AbstractModel[] all, out AbstractModel[] filtered,
+                out int cutCount, out int[]? cuts, out int[]? splits))
+            return null;
+        bool any = filtered.Length != 0;
+        AbstractModel[]?[]? inventories = null;
+        if (cutCount > 0)
+        {
+            inventories = new AbstractModel[]?[cutCount];
+            for (int c = 0; c < cutCount; c++) inventories[c] = InventoryOf(concrete.InventoryCutPlayer(c), slot, ref any);
+        }
+        if (Check) CheckDirect(concrete, all, filtered, cutCount, cuts, splits, inventories, slot);
+        // Nothing to yield: no handler runs, so no subscription can appear mid-dispatch either.
+        if (!any) return Array.Empty<AbstractModel>();
+        return WalkDirect(all, filtered, cutCount, cuts, splits, inventories, slot);
+    }
+
+    // The player's full inventory part (needed whole if a subscription appears mid-dispatch).
+    private static AbstractModel[]? InventoryOf(Player player, int slot, ref bool any)
+    {
+        IReadOnlyList<RelicModel> relics = player.Relics;
+        IReadOnlyList<PotionModel?> potions = player.PotionSlots;
+        int n = 0;
+        for (int r = 0; r < relics.Count; r++) if (!relics[r].IsMelted) n++;
+        for (int q = 0; q < potions.Count; q++) if (potions[q] is not null) n++;
+        if (n == 0) return null;
+        var inventory = new AbstractModel[n];
+        n = 0;
+        for (int r = 0; r < relics.Count; r++) if (!relics[r].IsMelted) inventory[n++] = relics[r];
+        for (int q = 0; q < potions.Count; q++) if (potions[q] is { } potion) inventory[n++] = potion;
+        for (int i = 0; i < inventory.Length && !any; i++) any = Overrides(inventory[i], slot);
+        return inventory;
+    }
+
+    /// <summary>Per cut, how many of <paramref name="filtered"/> (a subsequence of
+    /// <paramref name="all"/>) lie before that position.</summary>
+    internal static int[] SplitAtCuts(AbstractModel[] all, AbstractModel[] filtered, int[] cuts, int cutCount)
+    {
+        var splits = new int[cutCount];
+        int t = 0, f = 0;
+        for (int c = 0; c < cutCount; c++)
+        {
+            while (f < filtered.Length)
+            {
+                int p = t;
+                while (!ReferenceEquals(all[p], filtered[f])) p++;
+                if (p >= cuts[c]) break;
+                t = p + 1;
+                f++;
+            }
+            splits[c] = f;
+        }
+        return splits;
+    }
+
+    private static IEnumerable<AbstractModel> WalkDirect(AbstractModel[] all, AbstractModel[] filtered,
+        int cutCount, int[]? cuts, int[]? splits, AbstractModel[]?[]? inventories, int slot)
+    {
+        // Where the original sequence resumes after the last yielded listener: right after
+        // filtered[f - 1] (or the start) in its segment, or after inventory item resumeItem - 1.
+        int f = 0, resumeSegment = 0, resumeItem = 0;
+        bool resumeInCombat = true;
+        for (int c = 0; c <= cutCount; c++)
+        {
+            int end = c < cutCount ? splits![c] : filtered.Length;
+            while (f < end)
+            {
+                if (AbstractModel.ExecutionFinishedSubscribed) goto Rest;
+                yield return filtered[f++];
+                resumeSegment = c;
+                resumeInCombat = true;
+            }
+            if (c == cutCount) break;
+            AbstractModel[]? inventory = inventories![c];
+            if (inventory is null) continue;
+            for (int i = 0; i < inventory.Length; i++)
+            {
+                if (AbstractModel.ExecutionFinishedSubscribed) goto Rest;
+                if (!Keep(inventory[i], slot)) continue;
+                yield return inventory[i];
+                resumeSegment = c;
+                resumeInCombat = false;
+                resumeItem = i + 1;
+            }
+        }
+        if (!AbstractModel.ExecutionFinishedSubscribed) yield break;
+    Rest:
+        // A subscription appeared during the last yielded listener: everything after it now.
+        int from = resumeInCombat ? NextPosition(all, filtered, f) : cuts![resumeSegment];
+        foreach (AbstractModel rest in DirectRest(all, cutCount, cuts, inventories, resumeSegment, from,
+                     resumeInCombat ? 0 : resumeItem))
+            yield return rest;
+    }
+
+    // The original sequence from combat position `combatFrom` in segment `segment` (and item
+    // `inventoryFrom` of that segment's inventory) to the end.
+    private static IEnumerable<AbstractModel> DirectRest(AbstractModel[] all, int cutCount, int[]? cuts,
+        AbstractModel[]?[]? inventories, int segment, int combatFrom, int inventoryFrom)
+    {
+        int from = combatFrom;
+        for (int s = segment; s <= cutCount; s++)
+        {
+            int to = s < cutCount ? cuts![s] : all.Length;
+            for (int t = from; t < to; t++) yield return all[t];
+            if (s == cutCount) yield break;
+            if (inventories![s] is { } inventory)
+                for (int i = s == segment ? inventoryFrom : 0; i < inventory.Length; i++) yield return inventory[i];
+            from = to;
+        }
+    }
+
+    // A listener is yielded when it overrides the slot, or once ExecutionFinished has a
+    // subscriber (it would then be notified by the original loop).
+    private static bool Keep(AbstractModel model, int slot)
+    {
+        if (Overrides(model, slot) || AbstractModel.ExecutionFinishedSubscribed) return true;
+        if (Check) CheckDropped(model, slot);
+        return false;
+    }
+
+    private static bool AnyOverrides(IReadOnlyList<RelicModel> relics, int slot)
+    {
+        for (int r = 0; r < relics.Count; r++)
+            if (Overrides(relics[r], slot)) return true;
+        if (Check)
+            for (int r = 0; r < relics.Count; r++) CheckDropped(relics[r], slot);
+        return false;
+    }
+
+    // Position in `all` after the first `yielded` filtered listeners. `filtered` is `all` restricted
+    // to a type predicate, so greedy reference matching finds exactly their positions.
+    private static int NextPosition(AbstractModel[] all, AbstractModel[] filtered, int yielded)
+    {
+        int t = 0;
+        for (int j = 0; j < yielded; j++)
+        {
+            while (!ReferenceEquals(all[t], filtered[j])) t++;
+            t++;
+        }
+        return t;
+    }
+
+    // ---- SIMLAB_LISTENER_CHECK oracle ----
+
+    private static readonly ConcurrentDictionary<(Type, int), bool> OracleCache = new();
+
+    // Independent of Resolve: reflection's own most-derived lookup per overload signature.
+    private static bool OracleOverrides(Type type, int slot) => OracleCache.GetOrAdd((type, slot), static key =>
+    {
+        if (!IsKnownListenerType(key.Item1)) return true;
+        foreach (MethodInfo baseMethod in SlotMethods[key.Item2])
+        {
+            Type[] parameters = Array.ConvertAll(baseMethod.GetParameters(), p => p.ParameterType);
+            MethodInfo? found = key.Item1.GetMethod(baseMethod.Name, BindingFlags.Instance | BindingFlags.Public,
+                binder: null, parameters, modifiers: null);
+            if (found is null || found.DeclaringType != typeof(AbstractModel)) return true;
+        }
+        return false;
+    });
+
+    private static void CheckDropped(AbstractModel model, int slot)
+    {
+        if (OracleOverrides(model.GetType(), slot))
+            throw new InvalidOperationException(
+                $"hook filter dropped {model.GetType().Name}, which overrides slot {slot} ({SlotMethods[slot][0].Name})");
+    }
+
+    // The filtered combat part against a fresh, uncached build of the combat listeners.
+    private static void CheckCombat(CombatState combat, AbstractModel[] all, AbstractModel[] filtered, int slot)
+    {
+        AbstractModel[] fresh = combat.FreshCombatListenersForCheck();
+        Compare(fresh, filtered, slot, "combat");
+        if (fresh.Length != all.Length)
+            throw new InvalidOperationException($"hook filter: cached combat listeners {all.Length}, fresh {fresh.Length}");
+        for (int i = 0; i < fresh.Length; i++)
+            if (!ReferenceEquals(fresh[i], all[i]))
+                throw new InvalidOperationException($"hook filter: cached combat listener differs at {i}");
+    }
+
+    // The materialized dispatch against the original materialized source, read at the same moment.
+    private static void CheckSnapshot(IRunState runState, CombatState combat, AbstractModel[]? inventory,
+        AbstractModel[] filtered, int slot)
+    {
+        AbstractModel[] original = runState.IterateHookListeners(combat).ToArray();
+        var mine = new List<AbstractModel>();
+        if (inventory is not null)
+            foreach (AbstractModel model in inventory)
+                if (Overrides(model, slot)) mine.Add(model);
+        mine.AddRange(filtered);
+        Compare(original, mine.ToArray(), slot, "snapshot");
+    }
+
+    // The direct dispatch against a fresh BuildHookListeners(true): the reassembled full sequence
+    // (cached array with the inventories at the cuts) must equal it, and the kept part must too.
+    private static void CheckDirect(CombatState combat, AbstractModel[] all, AbstractModel[] filtered,
+        int cutCount, int[]? cuts, int[]? splits, AbstractModel[]?[]? inventories, int slot)
+    {
+        AbstractModel[] fresh = combat.FreshDirectListenersForCheck();
+        AbstractModel[] full = DirectRest(all, cutCount, cuts, inventories, 0, 0, 0).ToArray();
+        if (full.Length != fresh.Length)
+            throw new InvalidOperationException($"hook filter direct: full {full.Length}, fresh {fresh.Length}");
+        for (int i = 0; i < fresh.Length; i++)
+            if (!ReferenceEquals(full[i], fresh[i]))
+                throw new InvalidOperationException($"hook filter direct: full sequence differs at {i}");
+        var mine = new List<AbstractModel>();
+        int f = 0;
+        for (int c = 0; c <= cutCount; c++)
+        {
+            int end = c < cutCount ? splits![c] : filtered.Length;
+            while (f < end) mine.Add(filtered[f++]);
+            if (c < cutCount && inventories![c] is { } inventory)
+                foreach (AbstractModel model in inventory)
+                    if (Overrides(model, slot)) mine.Add(model);
+        }
+        Compare(fresh, mine.ToArray(), slot, "direct");
+    }
+
+    private static void Compare(AbstractModel[] original, AbstractModel[] filtered, int slot, string kind)
+    {
+        int k = 0;
+        for (int i = 0; i < original.Length; i++)
+        {
+            AbstractModel model = original[i];
+            if (!Overrides(model, slot))
+            {
+                CheckDropped(model, slot);
+                continue;
+            }
+            if (k >= filtered.Length || !ReferenceEquals(filtered[k], model))
+                throw new InvalidOperationException(
+                    $"hook filter {kind} mismatch at original {i} / filtered {k}, slot {slot} ({SlotMethods[slot][0].Name})");
+            // Keeping a non-overrider is harmless but would mean Resolve is off: flag it too.
+            if (!OracleOverrides(model.GetType(), slot))
+                throw new InvalidOperationException(
+                    $"hook filter kept {model.GetType().Name}, which does not override slot {slot} ({SlotMethods[slot][0].Name})");
+            k++;
+        }
+        if (k != filtered.Length)
+            throw new InvalidOperationException(
+                $"hook filter {kind}: {filtered.Length - k} extra listeners, slot {slot} ({SlotMethods[slot][0].Name})");
+    }
+}
