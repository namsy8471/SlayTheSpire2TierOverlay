+    /// <summary>Same as <see cref="Listeners"/> for loops over <c>IterateCombatHookListeners</c>,
+    /// which yield nothing once the combat is over or ending (and not starting).</summary>
+    internal static AbstractModel[]? CombatListeners(ICombatState combatState, int slot)
+    {
+        if (combatState is not CombatState) return null;
+        if (combatState.IsOverOrEnding() && !combatState.IsStarting()) return Array.Empty<AbstractModel>();
+        return Listeners(combatState.RunState, combatState, slot);
+    }
+
+    /// <summary>Filtered <c>combatState.IterateHookListeners()</c> (the combat's own array, no
+    /// inventory, no gate) for pure query loops (no InvokeExecutionFinished). Null: original.</summary>
+    internal static AbstractModel[]? CombatOnly(ICombatState combatState, int slot)
+    {
+        if (combatState is not CombatState concrete) return null;
+        AbstractModel[]? filtered = concrete.FilteredCombatListeners(slot, out AbstractModel[]? all);
+        if (filtered is not null && Check) CheckCombat(concrete, all!, filtered, slot);
+        return filtered;
+    }
