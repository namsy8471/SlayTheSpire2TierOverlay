new file mode 100644
index 0000000..c62acd9
--- /dev/null
+++ b/src/Sts2Sim.Core/Combat/ListVersion.cs
@@ -0,0 +1,57 @@
+using System.Runtime.CompilerServices;
+
+namespace Sts2Sim.Core.Combat;
+
+/// <summary>
+/// SimLab perf patch: reads <see cref="List{T}"/>'s private <c>_version</c>, which the BCL bumps on
+/// every content change (Add, Insert, Remove*, Clear, indexer set, Sort, Reverse, AddRange). The
+/// listener cache uses (list ref, version) as a witness of a list's whole contents, so validation
+/// does not have to touch every item. <see cref="Supported"/> is false if the field is missing or
+/// does not behave like that on this runtime; callers then compare items as before.
+/// </summary>
+internal static class ListVersion<T>
+{
+    [UnsafeAccessor(UnsafeAccessorKind.Field, Name = "_version")]
+    private static extern ref int VersionRef(List<T> list);
+
+    internal static readonly bool Supported = Probe();
+
+    internal static int Get(List<T> list) => VersionRef(list);
+
+    private static bool Probe()
+    {
+        try
+        {
+            var list = new List<T>();
+            int last = VersionRef(list);
+            bool Bumped(List<T> l)
+            {
+                int now = VersionRef(l);
+                bool changed = now != last;
+                last = now;
+                return changed;
+            }
+
+            list.Add(default!);
+            if (!Bumped(list)) return false;
+            list.Add(default!);
+            if (!Bumped(list)) return false;
+            list[0] = default!;
+            if (!Bumped(list)) return false;
+            list.Insert(1, default!);
+            if (!Bumped(list)) return false;
+            list.RemoveAt(0);
+            if (!Bumped(list)) return false;
+            list.Sort(static (_, _) => 0);
+            if (!Bumped(list)) return false;
+            list.Reverse();
+            if (!Bumped(list)) return false;
+            list.Clear();
+            return Bumped(list);
+        }
+        catch
+        {
+            return false;
+        }
+    }
+}
