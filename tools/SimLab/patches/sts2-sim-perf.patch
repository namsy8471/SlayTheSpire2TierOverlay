     // Block retention needs powers-before-relics ordering. Other dispatchers retain
     // the inventory-free iterator composed with RunState's existing wrapper.
     internal IEnumerable<AbstractModel> IterateHookListeners(bool includePlayerInventory)
+    {
+        if (!includePlayerInventory) return CombatListenersCached();
+        return BuildHookListeners(includePlayerInventory);
+    }
+
+    // SimLab perf patch: the inventory-free combat listener list is rebuilt for every hook
+    // dispatch. Reuse the last array while a zero-allocation witness scan of exactly the
+    // sources it was built from (creatures, powers, monster/player refs, active flags, orbs,
+    // piles, cards, enchantments, afflictions) still matches. The array is never mutated after
+    // it is published, so a caller holding an older array keeps its snapshot semantics.
+    private object?[]? _combatListenerWitness;
+    private AbstractModel[]? _combatListeners;
+
+    private IEnumerable<AbstractModel> CombatListenersCached()
+    {
+        if (_combatListeners is not null)
+        {
+            var check = new ListenerWitnessScan(_combatListenerWitness!);
+            if (ScanCreatureSources(_allies, ref check) && ScanCreatureSources(_enemies, ref check) && check.Complete)
+                return _combatListeners;
+        }
+        var scan = new ListenerWitnessScan(new List<object?>(128));
+        if (!ScanCreatureSources(_allies, ref scan) || !ScanCreatureSources(_enemies, ref scan))
+        {
+            _combatListeners = null;
+            return BuildHookListeners(false); // malformed sources: keep the original path
+        }
+        var built = (List<AbstractModel>)BuildHookListeners(false);
+        _combatListenerWitness = scan.Captured();
+        _combatListeners = built.ToArray();
+        return _combatListeners;
+    }
+
