+    // ---- Lazy and materialized stand-ins for the run-state iterator (relics, potions, combat) ----
+
+    // Shape preconditions: the iterator is RunState's or CombatRunStateSnapshot's, both walk
+    // their List<Player> (same list as Players), and nothing listens to ExecutionFinished.
+    private static bool Applies(IRunState runState) =>
+        !AbstractModel.ExecutionFinishedSubscribed && CombatState.HasStandardRunListeners(runState)
+        && runState.Players is List<Player>;
+
+    /// <summary>Lazy filtered stand-in for <c>IterateCombatHookListeners(combatState)</c>. Null: original.</summary>
+    internal static IEnumerable<AbstractModel>? Combat(ICombatState combatState, int slot)
+    {
+        if (combatState is not CombatState concrete) return null;
+        IRunState runState = concrete.RunState;
+        return Applies(runState) ? Lazy(runState, concrete, slot, gated: true) : null;
+    }
+
+    /// <summary>Lazy filtered stand-in for <c>runState.IterateHookListeners(combatState)</c>. Null: original.</summary>
+    internal static IEnumerable<AbstractModel>? Run(IRunState runState, ICombatState? combatState, int slot) =>
+        combatState is CombatState concrete && Applies(runState) ? Lazy(runState, concrete, slot, gated: false) : null;
+
+    /// <summary>Filtered stand-in for <c>IterateCombatHookListeners(combatState).ToArray()</c>. Null: original.</summary>
+    internal static IEnumerable<AbstractModel>? CombatSnapshot(ICombatState combatState, int slot)
+    {
+        if (combatState is not CombatState concrete) return null;
+        IRunState runState = concrete.RunState;
+        if (!Applies(runState)) return null;
+        if (concrete.IsOverOrEnding() && !concrete.IsStarting()) return Array.Empty<AbstractModel>();
+        return Snapshot(runState, concrete, slot);
+    }
+
+    /// <summary>Filtered stand-in for <c>runState.IterateHookListeners(combatState).ToArray()</c>. Null: original.</summary>
+    internal static IEnumerable<AbstractModel>? RunSnapshot(IRunState runState, ICombatState? combatState, int slot) =>
+        combatState is CombatState concrete && Applies(runState) ? Snapshot(runState, concrete, slot) : null;
+
+    // Mirrors RunState.IterateHookListeners / CombatRunStateSnapshot.IterateHookListeners with a
+    // combat child, step for step: the same player list enumeration, RunState's per-player relic
+    // snapshot taken when the player is reached (skipped when no relic in it overrides: nothing
+    // would be yielded from it), the snapshot's live relic enumeration, live potion enumeration,
+    // IsMelted read when the relic is reached, and the combat array fetched only after the last
+    // player, exactly when the original asks the combat for it.
+    private static IEnumerable<AbstractModel> Lazy(IRunState runState, CombatState combat, int slot, bool gated)
+    {
+        if (gated && combat.IsOverOrEnding() && !combat.IsStarting()) yield break;
+        bool relicSnapshot = runState is RunState;
+        foreach (Player player in (List<Player>)runState.Players)
+        {
+            if (relicSnapshot)
+            {
+                if (AbstractModel.ExecutionFinishedSubscribed || AnyOverrides(player.Relics, slot))
+                {
+                    foreach (RelicModel relic in player.Relics.ToArray())
+                    {
+                        if (!relic.IsMelted && Keep(relic, slot)) yield return relic;
+                    }
+                }
+            }
+            else if (player.Relics is List<RelicModel> relicList)
+            {
+                foreach (RelicModel relic in relicList)
+                {
+                    if (!relic.IsMelted && Keep(relic, slot)) yield return relic;
+                }
+            }
+            else
+            {
+                foreach (RelicModel relic in player.Relics)
+                {
+                    if (!relic.IsMelted && Keep(relic, slot)) yield return relic;
+                }
+            }
+
+            if (player.PotionSlots is List<PotionModel?> potionList)
+            {
+                foreach (PotionModel? potionSlot in potionList)
+                {
+                    if (potionSlot is PotionModel potion && Keep(potion, slot)) yield return potion;
+                }
+            }
+            else
+            {
+                foreach (PotionModel? potionSlot in player.PotionSlots)
+                {
+                    if (potionSlot is PotionModel potion && Keep(potion, slot)) yield return potion;
+                }
+            }
+        }
