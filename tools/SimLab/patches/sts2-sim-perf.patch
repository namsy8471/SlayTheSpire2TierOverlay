+        if (candidates.Length == 0)
+            throw new InvalidOperationException($"HookQueryFilter: no virtual {name}.");
+        SlotMethods[slot] = candidates;
+    }
+
+    internal static HookCoverage CoverageOf(AbstractModel model) =>
+        model.HookCoverageCache ??= Coverages.GetOrAdd(model.GetType(), static t => Resolve(t));
+
+    internal static bool Overrides(AbstractModel model, int slot) => CoverageOf(model).Has(slot);
+
+    /// <summary>Whether the model overrides any map-generation hook (unknown types count as yes).</summary>
+    internal static bool OverridesMapHooks(AbstractModel model)
+    {
+        HookCoverage coverage = CoverageOf(model);
+        return coverage.Has(Slot.MapGenerated) || coverage.Has(Slot.MapGeneratedLate) || coverage.Has(Slot.AfterMapGenerated);
+    }
+
+    private static bool IsKnownListenerType(Type type) =>
+        typeof(PowerModel).IsAssignableFrom(type) || typeof(MonsterModel).IsAssignableFrom(type)
+        || typeof(OrbModel).IsAssignableFrom(type) || typeof(CardModel).IsAssignableFrom(type)
+        || typeof(RelicModel).IsAssignableFrom(type) || typeof(PotionModel).IsAssignableFrom(type)
+        || typeof(AfflictionModel).IsAssignableFrom(type) || typeof(EnchantmentModel).IsAssignableFrom(type);
+
+    // Same resolution as HookOverrideIndex: per base method, the most derived declaration in the
+    // type chain; the slot counts as overridden unless that declaration is the base method itself.
+    // Types outside the eight listener classes keep every slot, so the unsupported-type throw in
+    // the dispatch loops still happens. Any reflection failure keeps every listener (fail-open).
+    private static HookCoverage Resolve(Type runtimeType)
+    {
+        var bits = new ulong[Words];
+        try
+        {
+            if (!IsKnownListenerType(runtimeType)) return All(bits);
+            var mostDerived = new Dictionary<MethodInfo, MethodInfo>();
+            for (Type? current = runtimeType; current is not null; current = current.BaseType)
+            {
+                foreach (MethodInfo method in current.GetMethods(BindingFlags.Instance |
+                    BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.DeclaredOnly))
+                {
+                    if (method.IsVirtual) mostDerived.TryAdd(method.GetBaseDefinition(), method);
+                }
+            }
+            for (int slot = 0; slot < Slot.Count; slot++)
+            {
+                foreach (MethodInfo baseMethod in SlotMethods[slot])
+                {
+                    if (mostDerived.TryGetValue(baseMethod, out MethodInfo? declared) && declared == baseMethod) continue;
+                    bits[slot >> 6] |= 1UL << slot;
+                    break;
+                }
+            }
+            return new HookCoverage(bits);
+        }
+        catch (Exception error) when (error is not OutOfMemoryException and not AccessViolationException)
+        {
+            return All(bits);
+        }
+
+        static HookCoverage All(ulong[] bits)
+        {
+            for (int slot = 0; slot < Slot.Count; slot++) bits[slot >> 6] |= 1UL << slot;
+            return new HookCoverage(bits);
+        }
+    }
+
+    internal static int SlotCount => Slot.Count;
+
+    /// <summary>The OR of the listeners' coverage, written into <paramref name="reuse"/> when given.</summary>
+    internal static ulong[] Union(AbstractModel[] listeners, ulong[]? reuse)
+    {
+        ulong[] union = reuse ?? new ulong[Words];
+        Array.Clear(union);
+        for (int i = 0; i < listeners.Length; i++) CoverageOf(listeners[i]).OrInto(union);
+        return union;
+    }
+
+    internal static bool UnionHas(ulong[] union, int slot) => (union[slot >> 6] & (1UL << slot)) != 0;
+
+    /// <summary>The listeners (same order) whose type overrides <paramref name="slot"/>.</summary>
+    internal static AbstractModel[] Filter(AbstractModel[] listeners, int slot)
+    {
+        int n = 0;
+        for (int i = 0; i < listeners.Length; i++) if (Overrides(listeners[i], slot)) n++;
+        if (n == 0) return Array.Empty<AbstractModel>();
+        var filtered = new AbstractModel[n];
+        n = 0;
+        for (int i = 0; i < listeners.Length; i++) if (Overrides(listeners[i], slot)) filtered[n++] = listeners[i];
+        return filtered;
+    }
+
+    /// <summary>
+    /// The listeners <c>runState.IterateHookListeners(combatState)</c> would yield, in the same
+    /// order, minus those that do not override <paramref name="slot"/>. Null when this shortcut
+    /// does not apply (unknown run/combat state types, no combat, malformed sources): the caller
+    /// then runs its original loop. Only for pure query loops (no InvokeExecutionFinished).
+    /// </summary>
+    internal static AbstractModel[]? Listeners(IRunState runState, ICombatState? combatState, int slot)
+    {
+        if (combatState is not CombatState concrete) return null;
+        if (!CombatState.HasStandardRunListeners(runState)) return null;
+        AbstractModel[]? combat = concrete.FilteredCombatListeners(slot, out _);
+        if (combat is null) return null;
+
+        // Relics (not melted) then potions per player, as both run-state iterators yield them.
+        List<AbstractModel>? inventory = null;
+        IReadOnlyList<Player> players = runState.Players;
+        for (int i = 0; i < players.Count; i++)
+        {
+            Player player = players[i];
+            // Indexed loops: foreach over the IReadOnlyList interface boxes an enumerator per call.
+            IReadOnlyList<RelicModel> relics = player.Relics;
+            for (int r = 0; r < relics.Count; r++)
+            {
+                RelicModel relic = relics[r];
+                if (!relic.IsMelted && Overrides(relic, slot)) (inventory ??= new List<AbstractModel>()).Add(relic);
+            }
+            IReadOnlyList<PotionModel?> potions = player.PotionSlots;
+            for (int q = 0; q < potions.Count; q++)
+                if (potions[q] is { } potion && Overrides(potion, slot)) (inventory ??= new List<AbstractModel>()).Add(potion);
+        }
+        if (inventory is null) return combat;
+        inventory.AddRange(combat);
+        return inventory.ToArray();
+    }
