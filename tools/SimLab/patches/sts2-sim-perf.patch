+/// <summary>
+/// SimLab perf patch: which hook slots a runtime type overrides (bit set), or every bit for a
+/// type that is not one of the eight listener classes. Immutable and shared by the type's
+/// instances (cached on each model in <see cref="AbstractModel.HookCoverageCache"/>).
+/// </summary>
+internal sealed class HookCoverage
+{
+    private readonly ulong[] _bits;
+
+    internal HookCoverage(ulong[] bits) => _bits = bits;
+
+    internal bool Has(int slot) => (_bits[slot >> 6] & (1UL << slot)) != 0;
+
+    internal void OrInto(ulong[] union)
+    {
+        for (int i = 0; i < _bits.Length; i++) union[i] |= _bits[i];
+    }
+}
