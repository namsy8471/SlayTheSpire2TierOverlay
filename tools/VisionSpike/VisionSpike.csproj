<Project Sdk="Microsoft.NET.Sdk">

  <!--
    M0 spike: can we identify a card on screen by its artwork?
    build-hashes : perceptual hash (pHash) of every extracted card portrait -> data/local/cardart-hashes.json
    match        : hash a region of a screenshot and list the closest cards
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Decodes WebP (card art) and PNG (captures). -->
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
  </ItemGroup>

</Project>
