<Window x:Class="OverlaySpike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sts2 Overlay Spike"
        Width="380" Height="250"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize">
    <Border CornerRadius="10" Background="#CC1E1E2E" BorderBrush="#FFD4AF37" BorderThickness="2" Padding="14">
        <StackPanel>
            <TextBlock Text="STS2 오버레이 테스트" Foreground="#FFD4AF37" FontSize="20" FontWeight="Bold" />
            <TextBlock x:Name="ClockText" Foreground="White" FontSize="14" Margin="0,6,0,0" />
            <TextBlock x:Name="GameText" Foreground="#FFB0B0C0" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="ModeText" Foreground="#FF8FD18F" FontSize="13" Margin="0,4,0,0" />
            <TextBlock x:Name="CaptureText" Foreground="#FFE0C070" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="Ctrl+F7: 클릭 통과 · Ctrl+F9: 게임 화면 캡처 · Ctrl+Shift+Q: 종료" Foreground="#FF808090" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>
