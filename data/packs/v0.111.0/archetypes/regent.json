      // SWORD_SAGE는 근거는 안정적이지만(95%) 비율이 31%라 core 기준(40%)에 못 미쳐(core 유지 7%) payoff로 옮겼습니다.
      // 예: https://op.gg/slay-the-spire2/history/6751787 https://op.gg/slay-the-spire2/history/5119239 https://op.gg/slay-the-spire2/history/4605613 https://op.gg/slay-the-spire2/history/7177823
      "cards": {
        "core": ["CARD.FURNACE"],
        "enabler": ["CARD.REFINE_BLADE", "CARD.BULWARK", "CARD.SPOILS_OF_BATTLE", "CARD.SUMMON_FORTH"],
        "payoff": ["CARD.PARRY", "CARD.SWORD_SAGE", "CARD.CONQUEROR"],
        "support": ["CARD.WROUGHT_IN_WAR"]
      },
      "fullWeight": 4.0,
      // essentialTarget: 빌드 덱이 가진 서로 다른 enabler·payoff 수의 중앙값 3 (부트스트랩 92%).
      "essentialTarget": 3,
      // FENCING_MANUAL: 빌드 덱 31/102·16명·lift 2.6·부트스트랩 98%.
      "keyRelics": [{ "id": "RELIC.FENCING_MANUAL", "w": 0.6 }],
      "needs": [{ "tag": "FORGE", "min": 3 }],
      "desc": "벼리기 카드와 매 턴 벼리는 파워로 검 토큰 한 장을 계속 키우고, 검 토큰에 반응하는 카드로 마무리하는 빌드",
      "guideHeroCard": "CARD.FURNACE"
    },
    {
      "id": "regent.creation",
      "names": { "kor": "카드 생성", "eng": "Creation" },
      "color": "#48c9b0",
      // 근거(OP.GG A10 승리 덱, v0.107+): 빌드 덱 115판·32명(우수 플레이어 73판·11명, 1위 플레이어 1판, 한 사람 최대 19판).
      // core PILLAR_OF_CREATION 비율 72%·lift 1.9·17명·부트스트랩 92%, core 유지 92%.
      // 불확실(부트스트랩 80% 미만, v1 역할 유지): MANIFEST_AUTHORITY enabler(58%), QUASAR enabler(36%).
      // 보조 근거(Baalorlord A10 리젠트 9판 중 5판 이상 + 축 카드 + OP.GG lift 1.0 이상이 부트스트랩 80% 이상): BEGONE 5/9.
      // core PILLAR_OF_CREATION은 v0.107.x 빌드 덱만 셉니다(31판). v1의 "core 비움"을 해제했습니다.
      // 예: https://op.gg/slay-the-spire2/history/7202938 https://op.gg/slay-the-spire2/history/6497786 https://op.gg/slay-the-spire2/history/4220586 https://op.gg/slay-the-spire2/history/4735621
      "cards": {
        "core": ["CARD.PILLAR_OF_CREATION"],
        "enabler": ["CARD.BEGONE", "CARD.CHARGE", "CARD.MANIFEST_AUTHORITY", "CARD.BUNDLE_OF_JOY", "CARD.QUASAR"],
        "payoff": ["CARD.ARSENAL", "CARD.SUPERMASSIVE"],
        "support": ["CARD.COLLISION_COURSE"]
      },
      "fullWeight": 4.0,
      // TOOLBOX: 불확실(빌드 덱 8/115·7명·lift 2.7, 부트스트랩 48%) → v1 값 유지.
      "keyRelics": [{ "id": "RELIC.TOOLBOX", "w": 0.3 }],
      "needs": [{ "tag": "CREATE", "min": 3 }],
      "desc": "무색·하수인 카드를 만들어 낼 때마다 방어도를 얻고, 만든 카드 수만큼 강해지는 공격으로 마무리하는 빌드",
