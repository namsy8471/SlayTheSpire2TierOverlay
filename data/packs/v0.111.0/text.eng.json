  "archetypes": {
    "defect.orb_focus": {
      "desc": "Defect's core plan: hold out with Frost Orbs and grow every Orb with Focus"
    },
    "defect.lightning": {
      "desc": "Offensive Orb build: Channel lots of Lightning and boost its trigger and Evoke damage"
    },
    "defect.status": {
      "desc": "Turns the Statuses your own cards add to your deck into a reward instead of a cost"
    },
    "defect.zero_cost": {
      "desc": "Collect lots of 0-cost cards, play them several times a turn and bring them back"
    },
    "defect.dark_orbs": {
      "desc": "Orb build that grows Dark Orbs, then Evokes them for big damage"
    },
    "defect.orb_variety": {
      "desc": "Channel a mix of Orb types and gain more for each distinct type"
    },
    "ironclad.strength": {
      "desc": "The classic build: stack permanent Strength, then cash it in with multi-hit attacks. Easy to neglect Block, so be careful"
    },
    "ironclad.exhaust": {
      "desc": "Engine that gains Block and draw whenever a card Exhausts. Self-Exhausting Block and Vulnerable cards feed the count"
    },
    "ironclad.block": {
      "desc": "Defensive deck that holds out with a thick layer of Block and Energy cards. Powers that keep or convert Block are rare in top decks"
    },
    "ironclad.self_damage": {
      "desc": "Each time you lose HP, hit ALL enemies, then finish with attacks that grow with HP lost. Needs healing too"
    },
    "ironclad.vulnerable": {
      "desc": "Apply Vulnerable often to get draw, extra hits and damage reduction"
    },
    "ironclad.attack_replay": {
      "desc": "Attack-heavy build: auto-play and copy big attacks, then finish with an attack that absorbs the attacks in your Hand"
    },
    "ironclad.strike_tempo": {
      "desc": "Tempo build that piles up cards with \"Strike\" in the name for fast pressure. Conflicts with removing basic cards"
    },
    "ironclad.hellraiser": {
      "desc": "Built around the Power that auto-plays drawn Strikes; Energy and draw cards cycle a lean deck fast"
    },
    "necrobinder.osty": {
      "desc": "Grow Osty into both your shield and main damage. Collect Osty attack cards around the Power that boosts them"
    },
    "necrobinder.doom": {
      "desc": "Spread Doom across enemies with Powers that deal damage per debuff applied. Reap the stacked Doom with finishers"
    },
    "necrobinder.ethereal": {
      "desc": "Play lots of Ethereal cards that vanish if unplayed, and finish with cards that grow per play. Samples mostly from the OP.GG #1 player's runs"
    },
    "regent.stars": {
      "desc": "Set up Powers that hit ALL enemies whenever you gain or spend Stars, and keep Stars cycling with cheap Star-cost cards"
    },
    "regent.star_spend": {
      "desc": "Bank next turn's resources, Retain your Hand, hold out with a Power that gives Block per Star spent, then finish with big Star-cost cards"
    },
    "regent.forge": {
      "desc": "Keep growing a single Sovereign Blade with Forge. Strong late finish once you get the Blade-replay Power"
    },
    "regent.creation": {
      "desc": "Gain Block whenever you create Colorless or Minion cards, then finish with an attack that grows with cards created"
    },
    "silent.poison": {
      "desc": "Stack Poison and hold out. Block cards to survive while the Poison works are a must"
    },
    "silent.shiv": {
      "desc": "Make lots of 0-cost Shivs and unload them with Shiv-boosting Powers"
    },
    "silent.sly_discard": {
      "desc": "Trigger Sly cards with cheap discard cards. Top players mostly layer it on a Shiv or Poison deck"
    }
