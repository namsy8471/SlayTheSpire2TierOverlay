<Project>
  <!--
    Shared build settings.
    Sts2GameDir points at the local Slay the Spire 2 install. Tools read game files from there
    (read-only); nothing from the game is ever copied into the repo.
    Override per machine in Directory.Build.local.props (gitignored) if the game lives elsewhere.
  -->
  <Import Project="Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Keep developer account and checkout paths out of published assemblies and symbols. -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/overlay/</PathMap>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- App version (tray "버전 ..." and the Velopack package). Releases override it: dotnet publish -p:Version=1.2.3 -->
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <Sts2GameDir Condition="'$(Sts2GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2</Sts2GameDir>
    <Sts2DataDir>$(Sts2GameDir)\data_sts2_windows_x86_64</Sts2DataDir>
  </PropertyGroup>
</Project>
