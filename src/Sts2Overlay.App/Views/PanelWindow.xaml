<Window x:Class="Sts2Overlay.App.Views.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Sts2Overlay.App.ViewModels"
        xmlns:svc="clr-namespace:Sts2Overlay.App.Services"
        xmlns:views="clr-namespace:Sts2Overlay.App.Views"
        xmlns:ctext="clr-namespace:Sts2Overlay.Core.Text;assembly=Sts2Overlay.Core"
        Title="{Binding PanelTitle, Source={x:Static vm:UiText.Instance}}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextMain}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
  <Window.Resources>
    <!-- Tab header buttons (radio buttons styled as tabs; SelectedTab picks the page) -->
    <Style x:Key="TabButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TextDim}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="0,6,0,5">
              <ContentPresenter HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Gold}" />
                <Setter Property="Foreground" Value="{StaticResource TextMain}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextMain}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="#22FFFFFF" CornerRadius="5" Padding="8,2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Dim" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextDim}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextDim}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>

    <Style x:Key="Empty" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextDim}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="2,14,2,14" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- Reason chip (green = helps, red = hurts) -->
    <DataTemplate x:Key="ChipTemplate" DataType="{x:Type vm:ChipVm}">
      <Border x:Name="Bd" CornerRadius="8" Padding="6,1,6,2" Margin="0,3,4,0" Background="{StaticResource ChipPos}">
        <TextBlock Text="{Binding Text}" FontSize="11" Foreground="White" />
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Positive}" Value="False">
          <Setter TargetName="Bd" Property="Background" Value="{StaticResource ChipNeg}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="WrapPanelTemplate">
      <WrapPanel />
    </ItemsPanelTemplate>

    <!-- Small tier tile -->
    <Style x:Key="TierTile" TargetType="Border">
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Card portrait: small thumbnail next to the name; hovering shows it large (the large image is decoded lazily) -->
    <DataTemplate x:Key="CardThumbTemplate" DataType="{x:Type svc:CardArtVm}">
      <Border CornerRadius="3" BorderBrush="#66FFFFFF" BorderThickness="1" Background="#40000000" Cursor="Help"
              ToolTipService.InitialShowDelay="120" ToolTipService.ShowDuration="60000" ToolTipService.Placement="Left">
        <Image Source="{Binding Thumb}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
        <Border.ToolTip>
          <ToolTip Padding="2" Background="#F0101318" BorderBrush="{StaticResource Gold}" BorderThickness="1.5">
            <Image Source="{Binding Large}" Width="380" Height="289" RenderOptions.BitmapScalingMode="HighQuality" />
          </ToolTip>
        </Border.ToolTip>
      </Border>
    </DataTemplate>

    <!--
      Relic hover text: large icon + name, then the effect text as the game words it (gold terms, blue numbers, energy icons).
      The effect box is hidden when the game's localization isn't extracted.
    -->
    <DataTemplate x:Key="RelicTipContentTemplate" DataType="{x:Type svc:RelicTipVm}">
      <StackPanel MaxWidth="340">
        <DockPanel>
          <Image DockPanel.Dock="Left" Source="{Binding Large}" Width="56" Height="56" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"
                 Visibility="{Binding Large, Converter={StaticResource BoolVis}}" />
          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
        <Border Padding="7,6" Margin="0,5,0,0" CornerRadius="3" Background="#26FFFFFF"
                Visibility="{Binding HasBody, Converter={StaticResource BoolVis}}">
          <TextBlock views:CardTextView.Runs="{Binding Body}" TextWrapping="Wrap" FontSize="13" LineHeight="18" />
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- Relic icon next to a row's name; hovering shows the relic's name and effect (RelicTipContentTemplate) -->
    <DataTemplate x:Key="RelicIconTemplate" DataType="{x:Type svc:RelicTipVm}">
      <Border CornerRadius="4" BorderBrush="#66FFFFFF" BorderThickness="1" Background="#40000000" Cursor="Help" Margin="0,0,3,0"
              ToolTipService.InitialShowDelay="120" ToolTipService.ShowDuration="60000" ToolTipService.Placement="Left">
        <Grid>
          <TextBlock Text="?" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding Thumb, Converter={StaticResource BoolVis}, ConverterParameter=!}" />
          <Image Source="{Binding Thumb}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        </Grid>
        <Border.ToolTip>
          <ToolTip Padding="7" Background="#F0101318" BorderBrush="{StaticResource Gold}" BorderThickness="1.5" Foreground="{StaticResource TextMain}">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RelicTipContentTemplate}" Focusable="False" />
          </ToolTip>
        </Border.ToolTip>
      </Border>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="HorizontalPanelTemplate">
      <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <!--
      Build tab relic tile: icon with a gold frame when owned, dimmed when not. Hover: relic text, why it suits the build, owned or not.
    -->
    <DataTemplate x:Key="BuildRelicTileTemplate" DataType="{x:Type vm:BuildRelicVm}">
      <Border x:Name="Frame" Width="36" Height="36" Margin="0,0,4,4" CornerRadius="4" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#40000000"
              Cursor="Help" ToolTipService.InitialShowDelay="120" ToolTipService.ShowDuration="60000" ToolTipService.Placement="Left">
        <Grid>
          <TextBlock Text="?" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding Relic.Thumb, Converter={StaticResource BoolVis}, ConverterParameter=!}" />
          <Image x:Name="Icon" Source="{Binding Relic.Thumb}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
          <Border Width="12" Height="12" CornerRadius="6" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource Gold}"
                  Visibility="{Binding Owned, Converter={StaticResource BoolVis}}">
            <TextBlock Text="&#x2713;" FontSize="8.5" FontWeight="Bold" Foreground="#1A1A1A" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Grid>
        <Border.ToolTip>
          <ToolTip Padding="7" Background="#F0101318" BorderBrush="{StaticResource Gold}" BorderThickness="1.5" Foreground="{StaticResource TextMain}">
            <StackPanel MaxWidth="340">
              <ContentControl Content="{Binding Relic}" ContentTemplate="{StaticResource RelicTipContentTemplate}" Focusable="False" />
              <TextBlock Text="{Binding ReasonText}" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,5,0,0" TextWrapping="Wrap" />
              <TextBlock Text="{Binding OwnedText}" FontSize="12" FontWeight="SemiBold" Margin="0,1,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#E59866" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Owned}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource Gold}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </ToolTip>
        </Border.ToolTip>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Owned}" Value="True">
          <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Gold}" />
          <Setter TargetName="Frame" Property="BorderThickness" Value="1.5" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Owned}" Value="False">
          <Setter TargetName="Icon" Property="Opacity" Value="0.55" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!--
      One face (base or upgraded) of a card's effect text: energy-cost orb (green when the upgrade changed it), star cost
      for Regent cards, then the description as the game composes it (keyword lines, gold terms, green upgraded numbers).
    -->
    <DataTemplate x:Key="CardFaceTemplate" DataType="{x:Type ctext:CardFace}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Margin="0,1,7,0" VerticalAlignment="Top">
          <Border Width="22" Height="22" CornerRadius="11" Background="#F08A24" BorderBrush="#FFE0A0" BorderThickness="1"
                  Visibility="{Binding Cost, Converter={StaticResource BoolVis}}">
            <TextBlock x:Name="CostText" Text="{Binding Cost}" FontSize="13" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <Border Width="22" Height="18" Margin="0,2,0,0" CornerRadius="3" Background="#33F7DC6F"
                  Visibility="{Binding StarCost, Converter={StaticResource BoolVis}}">
            <TextBlock FontSize="11" FontWeight="Bold" Foreground="#F7DC6F" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Run Text="{Binding StarCost, Mode=OneWay}" /><Run Text="★" />
            </TextBlock>
          </Border>
        </StackPanel>
        <TextBlock views:CardTextView.Runs="{Binding Body}" TextWrapping="Wrap" FontSize="13" LineHeight="18" />
      </DockPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding CostChanged}" Value="True">
          <Setter TargetName="CostText" Property="Foreground" Value="#B7F5C9" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!--
      빌드 tab card tile: portrait + name. Owned = gold frame and check; not owned = dimmed, so what is still needed stands out.
      Hover: name, role/rarity/tier, owned or not, the card's effect text (base and upgraded), and the large portrait
      (decoded only when the tooltip opens).
    -->
    <DataTemplate x:Key="BuildCardTileTemplate" DataType="{x:Type vm:BuildCardVm}">
      <StackPanel x:Name="Tile" Width="62" Margin="0,0,4,5" Background="Transparent" Cursor="Help"
                  ToolTipService.InitialShowDelay="120" ToolTipService.ShowDuration="60000" ToolTipService.Placement="Left">
        <Border x:Name="Frame" Height="46" CornerRadius="3" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#40000000">
          <Grid>
            <TextBlock Text="{Binding NoArt, Source={x:Static vm:UiText.Instance}}" FontSize="9.5" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding Art, Converter={StaticResource BoolVis}, ConverterParameter=!}" />
            <Image Source="{Binding Art.Thumb}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
            <Border CornerRadius="2" Padding="3,0,3,1" Margin="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="{Binding TierText, Converter={StaticResource TierBrush}}">
              <TextBlock Text="{Binding TierText}" FontSize="9.5" FontWeight="Bold"
                         Foreground="{Binding TierText, Converter={StaticResource TierBrush}, ConverterParameter=fg}" />
            </Border>
            <Border Width="14" Height="14" CornerRadius="7" Margin="1" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource Gold}"
                    Visibility="{Binding Owned, Converter={StaticResource BoolVis}}">
              <TextBlock Text="✓" FontSize="10" FontWeight="Bold" Foreground="#1A1A1A" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
        </Border>
        <TextBlock Text="{Binding Name}" FontSize="10.5" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
        <StackPanel.ToolTip>
          <ToolTip Padding="6" Background="#F0101318" BorderBrush="{StaticResource Gold}" BorderThickness="1.5" Foreground="{StaticResource TextMain}">
            <StackPanel MaxWidth="380">
              <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" />
              <TextBlock Text="{Binding DetailText}" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,1,0,0" />
              <TextBlock Text="{Binding OwnedText}" FontSize="12" FontWeight="SemiBold" Margin="0,1,0,5">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#E59866" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Owned}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource Gold}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <!-- Effect text (game localization + extracted numbers); hidden when the localization isn't extracted. -->
              <Border Padding="7,6" Margin="0,0,0,6" CornerRadius="3" Background="#26FFFFFF"
                      Visibility="{Binding Text, Converter={StaticResource BoolVis}}">
                <StackPanel>
                  <ContentControl Content="{Binding Text.Base}" ContentTemplate="{StaticResource CardFaceTemplate}" Focusable="False" />
                  <StackPanel Visibility="{Binding Text.Upgraded, Converter={StaticResource BoolVis}}">
                    <Border Height="1" Margin="0,6,0,5" Background="#33FFFFFF" />
                    <TextBlock FontSize="11.5" Foreground="{StaticResource UpgradeFg}" Margin="0,0,0,3">
                      <Run Text="{Binding AfterUpgrade, Source={x:Static vm:UiText.Instance}, Mode=OneWay}" /> <Run Text="{Binding Text.Upgraded.Title, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <ContentControl Content="{Binding Text.Upgraded}" ContentTemplate="{StaticResource CardFaceTemplate}" Focusable="False" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Image Source="{Binding Art.Large}" Width="380" Height="289" RenderOptions.BitmapScalingMode="HighQuality"
                     Visibility="{Binding Art, Converter={StaticResource BoolVis}}" />
            </StackPanel>
          </ToolTip>
        </StackPanel.ToolTip>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Owned}" Value="True">
          <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Gold}" />
          <Setter TargetName="Frame" Property="BorderThickness" Value="1.5" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Owned}" Value="False">
          <Setter TargetName="Tile" Property="Opacity" Value="0.5" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One offer row: card / skip / removal -->
    <DataTemplate x:Key="OfferRowTemplate" DataType="{x:Type vm:OfferRowVm}">
      <Border x:Name="Bd" Margin="0,0,0,6" Padding="8,6,8,7" CornerRadius="7" Background="{StaticResource RowBg}" BorderThickness="1.5" BorderBrush="Transparent">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.RowSpan="2" Orientation="Horizontal" Margin="0,0,9,0" VerticalAlignment="Center">
            <Border Width="34" Height="34" Style="{StaticResource TierTile}"
                    Background="{Binding TierText, Converter={StaticResource TierBrush}}">
              <TextBlock Text="{Binding TierText}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{Binding TierText, Converter={StaticResource TierBrush}, ConverterParameter=fg}" />
            </Border>
            <ContentControl Content="{Binding Art}" ContentTemplate="{StaticResource CardThumbTemplate}" Width="46" Height="35" Margin="6,0,0,0"
                            Visibility="{Binding Art, Converter={StaticResource BoolVis}}" />
            <ItemsControl ItemsSource="{Binding Relics}" ItemsPanel="{StaticResource HorizontalPanelTemplate}" Margin="6,0,0,0" Focusable="False"
                          Visibility="{Binding HasRelics, Converter={StaticResource BoolVis}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type svc:RelicTipVm}">
                  <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RelicIconTemplate}" Width="35" Height="35" Focusable="False" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Path Data="{StaticResource CrownGeometry}" Fill="{StaticResource Gold}" Width="15" Height="13" Stretch="Uniform" Margin="0,0,5,0"
                  Visibility="{Binding IsBest, Converter={StaticResource BoolVis}}" />
            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
            <Border Background="{StaticResource EstimateBg}" CornerRadius="4" Padding="4,0,4,1" Margin="6,0,0,0" VerticalAlignment="Center"
                    Visibility="{Binding IsEstimate, Converter={StaticResource BoolVis}}">
              <TextBlock Text="{Binding EstimateTag, Source={x:Static vm:UiText.Instance}}" FontSize="10.5" FontWeight="Bold" Foreground="White" />
            </Border>
            <Border Background="#1F58D68D" BorderBrush="{StaticResource UpgradeFg}" BorderThickness="1" CornerRadius="4" Padding="4,0,4,1" Margin="6,0,0,0" VerticalAlignment="Center"
                    Visibility="{Binding IsUpgraded, Converter={StaticResource BoolVis}}">
              <TextBlock Text="{Binding UpgradedTag, Source={x:Static vm:UiText.Instance}}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource UpgradeFg}" />
            </Border>
            <TextBlock Text="{Binding PriceText}" FontSize="12" Foreground="{StaticResource Gold}" Margin="8,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding PriceText, Converter={StaticResource BoolVis}}" />
          </StackPanel>

          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SubText}" Style="{StaticResource Dim}" Margin="0,1,0,0" />

          <StackPanel Grid.RowSpan="2" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
            <TextBlock Text="{Binding ScoreText}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" />
            <Border Width="70" Height="5" CornerRadius="2.5" Background="#30FFFFFF" HorizontalAlignment="Right" Margin="0,2,0,0">
              <Border Width="{Binding BarWidth}" CornerRadius="2.5" Background="{Binding TierText, Converter={StaticResource TierBrush}}" HorizontalAlignment="Left" />
            </Border>
          </StackPanel>

          <ItemsControl Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource ChipTemplate}"
                        ItemsPanel="{StaticResource WrapPanelTemplate}" Margin="0,2,0,0" />
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsBest}" Value="True">
          <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Gold}" />
          <Setter TargetName="Bd" Property="Background" Value="#2EF1C40F" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Unaffordable}" Value="True">
          <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One-line row for the "not offered this time" block: rank, name, score (effects in the tooltip) -->
    <DataTemplate x:Key="CompactOfferRowTemplate" DataType="{x:Type vm:OfferRowVm}">
      <Border Margin="0,0,0,3" Padding="8,3,8,3" CornerRadius="5" Background="{StaticResource RowBg}" ToolTip="{Binding Tip}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding SubText}" Style="{StaticResource Dim}" VerticalAlignment="Center" TextWrapping="NoWrap" />
          <DockPanel Grid.Column="1">
            <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Relics}" ItemsPanel="{StaticResource HorizontalPanelTemplate}" Margin="0,0,5,0" Focusable="False"
                          VerticalAlignment="Center" Visibility="{Binding HasRelics, Converter={StaticResource BoolVis}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type svc:RelicTipVm}">
                  <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RelicIconTemplate}" Width="22" Height="22" Focusable="False" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <TextBlock Grid.Column="2" Text="{Binding ScoreText}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <!-- UI 배율 / monitor DPI scale: WPF already applies Windows' DPI scaling, so we only add the remainder (Views/UiScale.cs). -->
    <Grid.LayoutTransform>
      <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
    </Grid.LayoutTransform>

    <Border Width="400" CornerRadius="10" Background="{Binding PanelBackground}" BorderBrush="#40FFFFFF" BorderThickness="1">
      <StackPanel>
        <!-- Header: drag handle -->
        <Grid x:Name="Header" Background="#01000000" Cursor="SizeAll" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="12,8,8,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding PanelHeader, Source={x:Static vm:UiText.Instance}}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Gold}" />
            <TextBlock Text="{Binding RunText}" Style="{StaticResource Dim}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
            <Border Background="#7D3C98" CornerRadius="4" Padding="5,1" Margin="0,0,4,0" Visibility="{Binding IsDemo, Converter={StaticResource BoolVis}}">
              <TextBlock Text="{Binding DemoTag, Source={x:Static vm:UiText.Instance}}" FontSize="11" FontWeight="Bold" />
            </Border>
            <Border Background="#B9770E" CornerRadius="4" Padding="5,1" Visibility="{Binding ClickThrough, Converter={StaticResource BoolVis}}">
              <TextBlock Text="{Binding ClickThroughTag, Source={x:Static vm:UiText.Instance}}" FontSize="11" FontWeight="Bold" />
            </Border>
          </StackPanel>
          <Button Grid.Column="2" Style="{StaticResource FlatButton}" Command="{Binding ToggleCollapseCommand}" VerticalAlignment="Center" ToolTip="{Binding CollapseToolTip, Source={x:Static vm:UiText.Instance}}">
            <TextBlock FontSize="12">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="{Binding Collapse, Source={x:Static vm:UiText.Instance}}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                      <Setter Property="Text" Value="{Binding Expand, Source={x:Static vm:UiText.Instance}}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Button>
        </Grid>

        <!-- Body -->
        <StackPanel Visibility="{Binding IsCollapsed, Converter={StaticResource BoolVis}, ConverterParameter=!}">
          <!-- ==== run review banner (m2/forecast-review) ==== -->
          <Border DataContext="{Binding Review}" Visibility="{Binding ShowBanner, Converter={StaticResource BoolVis}}"
                  Margin="8,0,8,6" Padding="9,5" CornerRadius="7" Background="#2EF1C40F" BorderBrush="{StaticResource Gold}" BorderThickness="1">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Margin="6,0,0,0" Content="{Binding Close, Source={x:Static vm:UiText.Instance}}"
                      Command="{Binding DataContext.DismissReviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="{Binding View, Source={x:Static vm:UiText.Instance}}"
                      Command="{Binding DataContext.ShowReviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock Text="{Binding BannerText}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
          </Border>
          <!-- ==== /run review banner ==== -->
          <UniformGrid Columns="5" Margin="8,0,8,0">
            <RadioButton Style="{StaticResource TabButton}" GroupName="Tabs" Content="{Binding TabOffer, Source={x:Static vm:UiText.Instance}}"
                         IsChecked="{Binding SelectedTab, Converter={StaticResource EnumMatch}, ConverterParameter=Offer}" />
            <RadioButton Style="{StaticResource TabButton}" GroupName="Tabs" Content="{Binding TabDeck, Source={x:Static vm:UiText.Instance}}"
                         IsChecked="{Binding SelectedTab, Converter={StaticResource EnumMatch}, ConverterParameter=Deck}" />
            <RadioButton Style="{StaticResource TabButton}" GroupName="Tabs" Content="{Binding TabBuild, Source={x:Static vm:UiText.Instance}}"
                         IsChecked="{Binding SelectedTab, Converter={StaticResource EnumMatch}, ConverterParameter=Build}" />
            <RadioButton Style="{StaticResource TabButton}" GroupName="Tabs" Content="{Binding TabPath, Source={x:Static vm:UiText.Instance}}"
                         IsChecked="{Binding SelectedTab, Converter={StaticResource EnumMatch}, ConverterParameter=Path}" />
            <RadioButton Style="{StaticResource TabButton}" GroupName="Tabs" Content="{Binding TabReview, Source={x:Static vm:UiText.Instance}}"
                         IsChecked="{Binding SelectedTab, Converter={StaticResource EnumMatch}, ConverterParameter=Review}" />
          </UniformGrid>
          <Border Height="1" Background="#26FFFFFF" Margin="8,0,8,0" />

          <ScrollViewer x:Name="Scroll" MaxHeight="620" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,8,6,4" Padding="0,0,4,0">
            <!--
              Each page is an outer Border (Visibility from the ROOT view model's SelectedTab) wrapping an inner
              StackPanel whose DataContext is the section (Offer/Deck/...). If both bindings sat on one element, the
              Visibility binding would look for SelectedTab on the section object, fail silently, and every page would show.
            -->
            <Grid>
              <!-- 추천 -->
              <Border Visibility="{Binding SelectedTab, Converter={StaticResource EnumMatch}, ConverterParameter=Offer}">
              <StackPanel DataContext="{Binding Offer}">
                <TextBlock Style="{StaticResource Empty}" Text="{Binding OfferEmpty, Source={x:Static vm:UiText.Instance}}"
                           Visibility="{Binding HasContent, Converter={StaticResource BoolVis}, ConverterParameter=!}" />
                <StackPanel Visibility="{Binding HasContent, Converter={StaticResource BoolVis}}">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStale}" Value="True">
                          <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <DockPanel Margin="0,0,0,4">
                    <Border DockPanel.Dock="Right" CornerRadius="9" Padding="8,1,8,2" VerticalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="#3A4A66" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding ConfidenceKind}" Value="Sure">
                              <Setter Property="Background" Value="#2E7D4F" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ConfidenceKind}" Value="Close">
                              <Setter Property="Background" Value="#B9770E" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ConfidenceKind}" Value="Estimate">
                              <Setter Property="Background" Value="#7D3C98" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ConfidenceText}" Value="">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding ConfidenceText}" FontSize="11.5" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                  </DockPanel>
                  <TextBlock Text="{Binding OfferStale, Source={x:Static vm:UiText.Instance}}" Style="{StaticResource Dim}" Margin="0,0,0,4"
                             Visibility="{Binding IsStale, Converter={StaticResource BoolVis}}" />
                  <TextBlock Text="{Binding FlipHint}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,6"
                             Visibility="{Binding FlipHint, Converter={StaticResource BoolVis}}" />
                  <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource OfferRowTemplate}" />
                  <TextBlock Text="{Binding Footer}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource Gold}" Margin="2,2,0,4"
                             Visibility="{Binding Footer, Converter={StaticResource BoolVis}}" />
                  <!-- 이번에 안 나온 선택지 (고대 존재): 참고용, 흐리게 -->
                  <StackPanel Opacity="0.6" Margin="0,6,0,0" Visibility="{Binding ExtraTitle, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding ExtraTitle}" Style="{StaticResource Dim}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,0,0,4" />
                    <ItemsControl ItemsSource="{Binding ExtraRows}" ItemTemplate="{StaticResource CompactOfferRowTemplate}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
              </Border>

              <!-- 덱 -->
              <Border Visibility="{Binding SelectedTab, Converter={StaticResource EnumMatch}, ConverterParameter=Deck}">
              <StackPanel DataContext="{Binding Deck}">
                <TextBlock Style="{StaticResource Empty}" Text="{Binding DeckEmpty, Source={x:Static vm:UiText.Instance}}"
                           Visibility="{Binding HasContent, Converter={StaticResource BoolVis}, ConverterParameter=!}" />
                <StackPanel Visibility="{Binding HasContent, Converter={StaticResource BoolVis}}">
                  <TextBlock Text="{Binding Summary}" FontSize="14" FontWeight="Bold" />
                  <TextBlock Text="{Binding RoleSupplyHeading, Source={x:Static vm:UiText.Instance}}" Style="{StaticResource Heading}" />
                  <ItemsControl ItemsSource="{Binding Roles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:RoleBarVm}">
                        <Grid Margin="0,1,0,1">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                          <Border Grid.Column="1" Height="7" CornerRadius="3.5" Background="#30FFFFFF" VerticalAlignment="Center">
                            <Border x:Name="Fill" Width="{Binding BarWidth}" CornerRadius="3.5" Background="#3498DB" HorizontalAlignment="Left" />
                          </Border>
                          <TextBlock Grid.Column="2" Text="{Binding ValueText}" Style="{StaticResource Dim}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsWeak}" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="#E74C3C" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:DeckGroupVm}">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" />
                          <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type vm:DeckCardVm}">
                                <Grid Margin="0,1,0,1">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" Style="{StaticResource TierTile}"
                                            Background="{Binding TierText, Converter={StaticResource TierBrush}}">
                                      <TextBlock Text="{Binding TierText}" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Foreground="{Binding TierText, Converter={StaticResource TierBrush}, ConverterParameter=fg}" />
                                    </Border>
                                    <ContentControl Content="{Binding Art}" ContentTemplate="{StaticResource CardThumbTemplate}" Width="29" Height="22" Margin="5,0,0,0"
                                                    Visibility="{Binding Art, Converter={StaticResource BoolVis}}" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <!-- log-only rebuild: this card's copy / upgrade is a guess; the tooltip says why -->
                                    <TextBlock Text=" ?" FontWeight="Bold" Foreground="#F1C40F" VerticalAlignment="Center" ToolTip="{Binding Doubt}"
                                               Visibility="{Binding Doubt, Converter={StaticResource BoolVis}}" />
                                  </StackPanel>
                                  <TextBlock Grid.Column="2" Text="{Binding UpgradeText}" Foreground="{StaticResource UpgradeFg}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                                  <TextBlock Grid.Column="3" Text="{Binding CountText}" FontWeight="Bold" Margin="8,0,2,0" VerticalAlignment="Center" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
              </Border>

              <!-- 빌드 -->
              <Border Visibility="{Binding SelectedTab, Converter={StaticResource EnumMatch}, ConverterParameter=Build}">
              <StackPanel>
              <!-- ==== build completion forecast (m2/forecast-review) ==== -->
              <StackPanel DataContext="{Binding Forecast}" Visibility="{Binding HasContent, Converter={StaticResource BoolVis}}" Margin="0,0,0,8">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ForecastRowVm}">
                      <StackPanel Margin="0,2,0,5">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding EndText}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                          <Ellipse Width="9" Height="9" Fill="{Binding Color}" Margin="0,0,6,0" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <Border Height="6" CornerRadius="3" Background="#30FFFFFF" Width="356" HorizontalAlignment="Left" Margin="0,3,0,2">
                          <Border Width="{Binding BarWidth}" CornerRadius="3" Background="{Binding Color}" HorizontalAlignment="Left" />
                        </Border>
                        <TextBlock Text="{Binding DetailText}" Style="{StaticResource Dim}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Note}" Style="{StaticResource Dim}" Opacity="0.85" Margin="0,2,0,0" />
                <Border Height="1" Background="#26FFFFFF" Margin="0,8,0,0" />
              </StackPanel>
              <!-- ==== /build completion forecast ==== -->
              <StackPanel DataContext="{Binding Build}">
                <TextBlock Style="{StaticResource Empty}" Text="{Binding BuildEmpty, Source={x:Static vm:UiText.Instance}}"
                           Visibility="{Binding HasContent, Converter={StaticResource BoolVis}, ConverterParameter=!}" />
                <StackPanel Visibility="{Binding HasContent, Converter={StaticResource BoolVis}}">
                  <TextBlock Text="{Binding Summary}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,6" />
                  <ItemsControl ItemsSource="{Binding Archetypes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:ArchetypeVm}">
                        <Border x:Name="Bd" Margin="0,0,0,6" Padding="9,7" CornerRadius="7" Background="{StaticResource RowBg}" BorderThickness="1.5" BorderBrush="Transparent">
                          <StackPanel>
                            <DockPanel>
                              <TextBlock DockPanel.Dock="Right" Text="{Binding StageText}" Foreground="#F39C12" FontSize="13" VerticalAlignment="Center" />
                              <Ellipse Width="10" Height="10" Fill="{Binding Color}" Margin="0,0,7,0" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                              <Border Background="#33F1C40F" BorderBrush="{StaticResource Gold}" BorderThickness="1" CornerRadius="4" Padding="4,0,4,1" Margin="7,0,0,0" VerticalAlignment="Center"
                                      HorizontalAlignment="Left" Visibility="{Binding IsPrimary, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding CurrentDirectionTag, Source={x:Static vm:UiText.Instance}}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Gold}" />
                              </Border>
                            </DockPanel>
                            <TextBlock Text="{Binding CommitText}" Style="{StaticResource Dim}" Margin="0,3,0,3" />
                            <Border Height="7" CornerRadius="3.5" Background="#30FFFFFF" Width="356" HorizontalAlignment="Left">
                              <Border Width="{Binding CompletionBarWidth}" CornerRadius="3.5" Background="{Binding Color}" HorizontalAlignment="Left" />
                            </Border>
                            <TextBlock Text="{Binding ProbabilityText}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding ProbabilityText, Converter={StaticResource BoolVis}}" />
                            <TextBlock Text="{Binding MissingText}" Style="{StaticResource Dim}" Margin="0,3,0,0"
                                       Visibility="{Binding MissingText, Converter={StaticResource BoolVis}}" />
                            <TextBlock Text="{Binding NeedsText}" Style="{StaticResource Dim}" Margin="0,2,0,0"
                                       Visibility="{Binding NeedsText, Converter={StaticResource BoolVis}}" />
                            <!-- this build's cards: header toggles the tiles (open by default for the current direction only) -->
                            <Button Command="{Binding ToggleCardsCommand}" Margin="0,6,0,0" Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Visibility="{Binding CardsSummaryText, Converter={StaticResource BoolVis}}" ToolTip="{Binding BuildCardsToolTip, Source={x:Static vm:UiText.Instance}}">
                              <Button.Template>
                                <ControlTemplate TargetType="Button">
                                  <Border x:Name="Bd" Background="#14FFFFFF" CornerRadius="4" Padding="6,2,6,3">
                                    <ContentPresenter />
                                  </Border>
                                  <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                      <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF" />
                                    </Trigger>
                                  </ControlTemplate.Triggers>
                                </ControlTemplate>
                              </Button.Template>
                              <StackPanel Orientation="Horizontal">
                                <!-- Text from a style, not a local value: a local Text would beat the trigger -->
                                <TextBlock FontSize="11.5" Foreground="{StaticResource TextDim}">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                      <Setter Property="Text" Value="{Binding ShowBuildCards, Source={x:Static vm:UiText.Instance}}" />
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                          <Setter Property="Text" Value="{Binding HideBuildCards, Source={x:Static vm:UiText.Instance}}" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text=" · " FontSize="11.5" Foreground="{StaticResource TextDim}" />
                                <TextBlock Text="{Binding CardsSummaryText}" FontSize="11.5" />
                              </StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding CardGroups}" Margin="0,2,0,0" Focusable="False"
                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BuildCardGroupVm}">
                                  <StackPanel Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDim}" Margin="1,0,0,3" />
                                    <ItemsControl ItemsSource="{Binding Cards}" ItemsPanel="{StaticResource WrapPanelTemplate}"
                                                  ItemTemplate="{StaticResource BuildCardTileTemplate}" Focusable="False" />
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- relics that suit this build (key relics, ranker favourites); shown with the card tiles -->
                            <StackPanel Margin="0,4,0,0">
                              <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <MultiDataTrigger>
                                      <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsExpanded}" Value="True" />
                                        <Condition Binding="{Binding HasRelics}" Value="True" />
                                      </MultiDataTrigger.Conditions>
                                      <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </StackPanel.Style>
                              <TextBlock Text="{Binding BuildRelics, Source={x:Static vm:UiText.Instance}}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDim}" Margin="1,0,0,3" />
                              <ItemsControl ItemsSource="{Binding Relics}" ItemsPanel="{StaticResource WrapPanelTemplate}"
                                            ItemTemplate="{StaticResource BuildRelicTileTemplate}" Focusable="False" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#66F1C40F" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
              </StackPanel>
              </Border>

              <!-- 경로 -->
              <Border Visibility="{Binding SelectedTab, Converter={StaticResource EnumMatch}, ConverterParameter=Path}">
              <StackPanel DataContext="{Binding Path}">
                <TextBlock Style="{StaticResource Empty}" Text="{Binding PathEmpty, Source={x:Static vm:UiText.Instance}}"
                           Visibility="{Binding HasContent, Converter={StaticResource BoolVis}, ConverterParameter=!}" />
                <StackPanel Visibility="{Binding HasContent, Converter={StaticResource BoolVis}}">
                  <TextBlock Text="{Binding NextStep}" FontSize="14" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"
                             Visibility="{Binding NextStep, Converter={StaticResource BoolVis}}" />
                  <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:PathOptionVm}">
                        <Border x:Name="Bd" Margin="0,0,0,6" Padding="9,7" CornerRadius="7" Background="{StaticResource RowBg}" BorderThickness="1.5" BorderBrush="Transparent">
                          <StackPanel>
                            <DockPanel>
                              <TextBlock DockPanel.Dock="Right" Text="{Binding ScoreText}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                              <Border Background="#3A4A66" CornerRadius="4" Padding="6,0,6,1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Label}" FontWeight="Bold" />
                              </Border>
                            </DockPanel>
                            <TextBlock Text="{Binding Summary}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <ItemsControl ItemsSource="{Binding Chips}" ItemsPanel="{StaticResource WrapPanelTemplate}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border CornerRadius="8" Padding="6,1,6,2" Margin="0,4,4,0" Background="#33FFFFFF">
                                    <TextBlock Text="{Binding}" FontSize="11" />
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Gold}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding Note}" Style="{StaticResource Dim}" Visibility="{Binding Note, Converter={StaticResource BoolVis}}" />
                </StackPanel>
              </StackPanel>
              </Border>

              <!-- ==== 리뷰 (m2/forecast-review) ==== -->
              <Border Visibility="{Binding SelectedTab, Converter={StaticResource EnumMatch}, ConverterParameter=Review}">
              <StackPanel DataContext="{Binding Review}">
                <TextBlock Style="{StaticResource Empty}" Text="{Binding ReviewEmpty, Source={x:Static vm:UiText.Instance}}"
                           Visibility="{Binding HasContent, Converter={StaticResource BoolVis}, ConverterParameter=!}" />
                <StackPanel Visibility="{Binding HasContent, Converter={StaticResource BoolVis}}">
                  <TextBlock Text="{Binding ReviewHeading, Source={x:Static vm:UiText.Instance}}" Style="{StaticResource Heading}" Margin="0,0,0,2" />
                  <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding AgreementText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,3" />
                  <Border Height="7" CornerRadius="3.5" Background="#30FFFFFF" Width="356" HorizontalAlignment="Left">
                    <Border Width="{Binding AgreementBarWidth}" CornerRadius="3.5" Background="{StaticResource Gold}" HorizontalAlignment="Left" />
                  </Border>
                  <DockPanel Margin="0,8,0,0">
                    <Ellipse Width="10" Height="10" Fill="{Binding BuildColor}" Margin="0,3,7,0" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding BuildText}" TextWrapping="Wrap" FontSize="12.5" />
                  </DockPanel>
                  <TextBlock Text="{Binding DisagreementsHeading, Source={x:Static vm:UiText.Instance}}" Style="{StaticResource Heading}"
                             Visibility="{Binding HasDisagreements, Converter={StaticResource BoolVis}}" />
                  <ItemsControl ItemsSource="{Binding Disagreements}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:ReviewDisagreementVm}">
                        <Border Margin="0,0,0,6" Padding="9,6" CornerRadius="7" Background="{StaticResource RowBg}">
                          <StackPanel>
                            <DockPanel>
                              <TextBlock DockPanel.Dock="Right" Text="{Binding GapText}" FontWeight="Bold" Foreground="#E74C3C" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Header}" FontWeight="Bold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding OfferedText}" Style="{StaticResource Dim}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding ChoiceText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding Note}" Style="{StaticResource Dim}" Visibility="{Binding Note, Converter={StaticResource BoolVis}}" />
                </StackPanel>
              </StackPanel>
              </Border>
              <!-- ==== /리뷰 ==== -->
            </Grid>
          </ScrollViewer>

          <!-- local resources / version guard banner (Services.LocalResourceService) -->
          <TextBlock Text="{Binding ResourceBanner}" Style="{StaticResource Dim}" Foreground="#F0B27A" TextWrapping="Wrap" Margin="12,2,12,2"
                     Visibility="{Binding ResourceBanner, Converter={StaticResource BoolVis}}" />
          <!-- standing app notices: hotkeys taken by another program, game not 16:9 (Controllers/AppController.Shell.cs) -->
          <TextBlock Text="{Binding ShellNotice}" Style="{StaticResource Dim}" Foreground="#F0B27A" TextWrapping="Wrap" Margin="12,2,12,2"
                     Visibility="{Binding ShellNotice, Converter={StaticResource BoolVis}}" />
          <!-- downloaded update waiting to be applied (Services.UpdateService) -->
          <TextBlock Text="{Binding UpdateText}" Style="{StaticResource Dim}" Foreground="#58D68D" TextWrapping="Wrap" Margin="12,2,12,2"
                     Visibility="{Binding UpdateText, Converter={StaticResource BoolVis}}" />
          <TextBlock Text="{Binding MessageText}" Style="{StaticResource Dim}" Foreground="#F5B041" Margin="12,2,12,2"
                     Visibility="{Binding MessageText, Converter={StaticResource BoolVis}}" />
          <Border Height="1" Background="#26FFFFFF" Margin="8,4,8,0" />
          <StackPanel Margin="12,4,12,8">
            <TextBlock Style="{StaticResource Dim}">
              <Run Text="{Binding StatusText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding PackText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding UiScaleText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Style="{StaticResource Dim}" Text="{Binding HotkeyHint, Source={x:Static vm:UiText.Instance}}" Opacity="0.8" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
