<Window x:Class="Sts2Overlay.App.Views.BadgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Sts2Overlay.App.ViewModels"
        Title="STS2 Badges"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" IsHitTestVisible="False"
        Left="0" Top="0" Width="100" Height="100"
        FontFamily="{StaticResource UiFont}">
  <!--
    Full-game-size transparent layer. Click-through is done with WS_EX_TRANSPARENT in code-behind
    (IsHitTestVisible only affects WPF's own hit testing, not where Windows sends the mouse).
  -->
  <Grid>
    <!-- Demo and debug outline mode (Ctrl+F11): dashed outline of each recognised card (blue) and price label (orange). -->
    <ItemsControl ItemsSource="{Binding Bounds}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Canvas />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemContainerStyle>
        <Style TargetType="ContentPresenter">
          <Setter Property="Canvas.Left" Value="{Binding Left}" />
          <Setter Property="Canvas.Top" Value="{Binding Top}" />
        </Style>
      </ItemsControl.ItemContainerStyle>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Rectangle x:Name="Box" Width="{Binding Width}" Height="{Binding Height}" Stroke="#AA5DADE2" StrokeThickness="2"
                     StrokeDashArray="4 3" Fill="#145DADE2" RadiusX="8" RadiusY="8" />
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsPrice}" Value="True">
              <Setter TargetName="Box" Property="Stroke" Value="#CCF39C12" />
              <Setter TargetName="Box" Property="Fill" Value="#18F39C12" />
              <Setter TargetName="Box" Property="RadiusX" Value="3" />
              <Setter TargetName="Box" Property="RadiusY" Value="3" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <ItemsControl ItemsSource="{Binding Badges}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Canvas />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemContainerStyle>
        <Style TargetType="ContentPresenter">
          <Setter Property="Canvas.Left" Value="{Binding Left}" />
          <Setter Property="Canvas.Top" Value="{Binding Top}" />
        </Style>
      </ItemsControl.ItemContainerStyle>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border x:Name="Pill" Width="170" Height="40" CornerRadius="9" Background="#EC15161C"
                  BorderThickness="2" BorderBrush="{Binding TierText, Converter={StaticResource TierBrush}}">
            <Border.LayoutTransform>
              <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
            </Border.LayoutTransform>
            <Grid Margin="3,0,6,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <!-- Tier letter tile -->
              <Border Width="31" Height="31" CornerRadius="6" VerticalAlignment="Center"
                      Background="{Binding TierText, Converter={StaticResource TierBrush}}">
                <TextBlock Text="{Binding TierText}" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{Binding TierText, Converter={StaticResource TierBrush}, ConverterParameter=fg}" />
              </Border>
              <!-- Score, upgrade "+", estimate tag -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0,0,0">
                <TextBlock Text="{Binding ScoreText}" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                <TextBlock Text="+" FontSize="21" FontWeight="Black" Foreground="{StaticResource UpgradeFg}" Margin="2,-2,0,0" VerticalAlignment="Center"
                           Visibility="{Binding IsUpgraded, Converter={StaticResource BoolVis}}" />
                <Border Background="{StaticResource EstimateBg}" CornerRadius="4" Padding="4,0" Margin="5,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding IsEstimate, Converter={StaticResource BoolVis}}">
                  <TextBlock Text="{Binding EstimateTag, Source={x:Static vm:UiText.Instance}}" FontSize="11" FontWeight="Bold" Foreground="White" />
                </Border>
              </StackPanel>
              <!-- Recommended pick (hidden when a ribbon is pinned here: the ribbon says it louder) -->
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                          Visibility="{Binding ShowCrown, Converter={StaticResource BoolVis}}">
                <Path Data="{StaticResource CrownGeometry}" Fill="{StaticResource Gold}" Width="17" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="{Binding PickTag, Source={x:Static vm:UiText.Instance}}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Gold}" Margin="3,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsBest}" Value="True">
              <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Gold}" />
              <Setter TargetName="Pill" Property="BorderThickness" Value="3" />
              <Setter TargetName="Pill" Property="Background" Value="#F2231E0C" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!--
      Reason chips under each reward card ("광역 부족 +24"): the top 1-2 reasons, so the player does not need the panel.
      The stack is DesignWidth wide and scaled with the card (LayoutTransform), chips are centred and trimmed to it.
    -->
    <ItemsControl ItemsSource="{Binding ChipStacks}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Canvas />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemContainerStyle>
        <Style TargetType="ContentPresenter">
          <Setter Property="Canvas.Left" Value="{Binding Left}" />
          <Setter Property="Canvas.Top" Value="{Binding Top}" />
        </Style>
      </ItemsControl.ItemContainerStyle>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <ItemsControl ItemsSource="{Binding Chips}" Width="{Binding DesignWidth}">
            <ItemsControl.LayoutTransform>
              <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
            </ItemsControl.LayoutTransform>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="Chip" Height="22" CornerRadius="11" Padding="9,0" Margin="0,0,0,3" HorizontalAlignment="Center"
                        Background="#EB1D4A33" BorderBrush="#9958D68D" BorderThickness="1">
                  <TextBlock Text="{Binding Text}" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Positive}" Value="False">
                    <Setter TargetName="Chip" Property="Background" Value="#EB4A1D1D" />
                    <Setter TargetName="Chip" Property="BorderBrush" Value="#99E57373" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Gold "추천!" / "구매!" ribbon pinned on the right end of the recommended card's badge (a tag with a notched left end). -->
    <ItemsControl ItemsSource="{Binding Ribbons}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Canvas />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemContainerStyle>
        <Style TargetType="ContentPresenter">
          <Setter Property="Canvas.Left" Value="{Binding Left}" />
          <Setter Property="Canvas.Top" Value="{Binding Top}" />
        </Style>
      </ItemsControl.ItemContainerStyle>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Width="84" Height="30">
            <Grid.LayoutTransform>
              <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
            </Grid.LayoutTransform>
            <Path Data="M0,0 L84,0 L84,30 L0,30 L9,15 Z" Fill="{StaticResource Gold}" Stroke="#7A5C00" StrokeThickness="1.5" />
            <TextBlock Text="{Binding Text}" FontSize="17" FontWeight="Black" Foreground="#2A1E00" Margin="7,0,0,0"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- "스킵 추천!" pill under the cards (below the game's own skip button) when the engine recommends skipping -->
    <Canvas>
      <Border x:Name="SkipPill" Canvas.Left="{Binding Skip.Left}" Canvas.Top="{Binding Skip.Top}"
              Visibility="{Binding Skip, Converter={StaticResource BoolVis}}"
              Width="300" Height="40" CornerRadius="9" Background="#F2231E0C" BorderBrush="{StaticResource Gold}" BorderThickness="3">
        <Border.LayoutTransform>
          <ScaleTransform ScaleX="{Binding Skip.Scale}" ScaleY="{Binding Skip.Scale}" />
        </Border.LayoutTransform>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0">
          <Path Data="{StaticResource CrownGeometry}" Fill="{StaticResource Gold}" Width="17" Height="15" Stretch="Uniform" />
          <TextBlock Text="{Binding SkipPick, Source={x:Static vm:UiText.Instance}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Gold}" Margin="6,0,0,0" />
          <TextBlock Text="{Binding Skip.ScoreText}" FontSize="16" FontWeight="Bold" Foreground="White" Margin="8,0,0,0" />
          <TextBlock Text="{Binding Skip.Reason}" FontSize="13" FontWeight="Bold" Foreground="#C8CDD6" Margin="10,1,0,0" MaxWidth="130"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Canvas>

    <!-- "제거 추천: 타격" over the shop's card-removal coin, with a small pointer down at the coin -->
    <Canvas>
      <Grid Canvas.Left="{Binding Removal.Left}" Canvas.Top="{Binding Removal.Top}" Width="230" Height="34"
            Visibility="{Binding Removal, Converter={StaticResource BoolVis}}">
        <Grid.LayoutTransform>
          <ScaleTransform ScaleX="{Binding Removal.Scale}" ScaleY="{Binding Removal.Scale}" />
        </Grid.LayoutTransform>
        <Path Data="M107,33 L123,33 L115,42 Z" Fill="{StaticResource Gold}" />
        <Border CornerRadius="8" Background="#F2231E0C" BorderBrush="{StaticResource Gold}" BorderThickness="2.5">
          <TextBlock Text="{Binding Removal.Text}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Gold}" Margin="8,0"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Border>
      </Grid>
    </Canvas>
  </Grid>
</Window>
