<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The overlay app (PLAN §5.0 / §5.4): game window tracking, WGC/GDI capture, badge layer, panel, tray, hotkeys.
    Game-state reading and card recognition are plugged in through Integration/ interfaces.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      The Windows 10 SDK version in the TFM brings the C#/WinRT projection of Windows.Graphics.Capture (no NuGet package:
      it is a targeting pack of the .NET SDK). 22621 is needed to see GraphicsCaptureSession.IsBorderRequired; the app
      still runs on Windows 10 2004 (19041), and the platform analyzer makes us guard anything newer.
    -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- Direct3D 11 calls through COM vtable function pointers (Interop/D3D11Interop.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (System.Windows.Forms.NotifyIcon) and drawing its icon (System.Drawing). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Sts2Overlay.App</RootNamespace>
    <AssemblyName>Sts2Overlay</AssemblyName>
    <!-- WPF text layout (Korean IME, number formatting in bindings) wants real culture data. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Declares Per-Monitor V2 DPI awareness; see the comments in app.manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      WFO0003 is a WinForms analyzer rule ("set DPI via Application.SetHighDpiMode, not the manifest"). It assumes
      WinForms owns startup; here WPF does, and the manifest is the documented way to make a WPF app Per-Monitor V2.
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <!-- WinForms adds global usings (System.Windows.Forms, System.Drawing) whose names clash with WPF (Application, Point, Brush...). -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sts2Overlay.Core\Sts2Overlay.Core.csproj" />
    <ProjectReference Include="..\Sts2Overlay.GameState\Sts2Overlay.GameState.csproj" />
    <ProjectReference Include="..\Sts2Overlay.Resources\Sts2Overlay.Resources.csproj" />
    <ProjectReference Include="..\Sts2Overlay.Vision\Sts2Overlay.Vision.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sts2Overlay.App.Tests" />
  </ItemGroup>

</Project>
