<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The overlay app (PLAN §5.0 / §5.4): game window tracking, WGC/GDI capture, badge layer, panel, tray, hotkeys.
    Game-state reading and card recognition are plugged in through Integration/ interfaces.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      The Windows 10 SDK version in the TFM brings the C#/WinRT projection of Windows.Graphics.Capture (no NuGet package:
      it is a targeting pack of the .NET SDK). 22621 is needed to see GraphicsCaptureSession.IsBorderRequired; the app
      still runs on Windows 10 2004 (19041), and the platform analyzer makes us guard anything newer.
    -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- Direct3D 11 calls through COM vtable function pointers (Interop/D3D11Interop.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (System.Windows.Forms.NotifyIcon) and drawing its icon (System.Drawing). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Sts2Overlay.App</RootNamespace>
    <AssemblyName>Sts2Overlay</AssemblyName>
    <!-- WPF text layout (Korean IME, number formatting in bindings) wants real culture data. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Declares Per-Monitor V2 DPI awareness; see the comments in app.manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      WFO0003 is a WinForms analyzer rule ("set DPI via Application.SetHighDpiMode, not the manifest"). It assumes
      WinForms owns startup; here WPF does, and the manifest is the documented way to make a WPF app Per-Monitor V2.
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- Exe/installer/shortcut/tray icon: our own drawing (red card + spire + gold "S" coin), no game art.
         Source: Assets/icon.svg; regenerate the .ico with tools/make-icon.ps1. -->
    <ApplicationIcon>Assets\Sts2Overlay.ico</ApplicationIcon>
    <!--
      Our own Main (App.Main in App.xaml.cs) instead of the one WPF generates from App.xaml: Velopack's
      install/update/uninstall hooks (VelopackApp.Build().Run()) must run before anything else, including WPF start-up.
    -->
    <StartupObject>Sts2Overlay.App.App</StartupObject>
    <!--
      Install size (docs/DISTRIBUTION.md "설치 크기"). Framework-dependent: the app uses the .NET 10 Desktop Runtime
      installed on the PC instead of carrying its own copy (about 150 MB of the old 214 MB install). The installer and
      the updater put the runtime in when it is missing (the "framework" option of vpk pack in the release scripts).
      Satellite resources: the UI is Korean or English, so the other languages' resource folders are left out.
    -->
    <SelfContained>false</SelfContained>
    <SatelliteResourceLanguages>ko;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- App.xaml stays the application resource dictionary (InitializeComponent) but no longer generates Main. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Auto-update (Services/UpdateService.cs). Keep in step with the vpk tool in .config/dotnet-tools.json. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray icon: the same .ico, read from the assembly so the right size can be picked. -->
    <EmbeddedResource Include="Assets\Sts2Overlay.ico" LogicalName="Sts2Overlay.ico" />
  </ItemGroup>

  <!--
    Installed builds have no repo next to them, so the data the app reads at run time is published next to the exe
    under data/ (Infrastructure/AppPaths.cs finds it there). Publish only: not into bin/ and not into the test projects.
    Gitignored game-text catalogs (catalog.*.json) and local overrides never ship.
  -->
  <ItemGroup>
    <Content Include="..\..\data\packs\**\*.json" Exclude="..\..\data\**\catalog.*.json;..\..\data\**\user_overrides.json"
             Link="data\packs\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\data\catalog\*.json" Exclude="..\..\data\**\catalog.*.json"
             Link="data\catalog\%(Filename)%(Extension)"
             CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- WinForms adds global usings (System.Windows.Forms, System.Drawing) whose names clash with WPF (Application, Point, Brush...). -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sts2Overlay.Core\Sts2Overlay.Core.csproj" />
    <ProjectReference Include="..\Sts2Overlay.GameState\Sts2Overlay.GameState.csproj" />
    <ProjectReference Include="..\Sts2Overlay.Resources\Sts2Overlay.Resources.csproj" />
    <ProjectReference Include="..\Sts2Overlay.Vision\Sts2Overlay.Vision.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sts2Overlay.App.Tests" />
  </ItemGroup>

</Project>
