<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Reads game state WITHOUT a mod: save files (current_run*.save) + godot.log, and combines them
    into one live snapshot. Platform-neutral (no WPF / Win32), so it is unit-testable anywhere.
  -->
  <PropertyGroup>
    <RootNamespace>Sts2Overlay.GameState</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1573: records document only the non-obvious positional parameters. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sts2Overlay.Core\Sts2Overlay.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Names-free starting decks generated by tools/CatalogBuilder - embedded so no path lookup is needed. -->
    <EmbeddedResource Include="..\..\data\catalog\starting-decks.v0.107.1.json" LogicalName="starting-decks.json" />
    <!-- Names-free card catalog: only id -> rarity is read (tokens/statuses made in a fight are never deck cards). -->
    <EmbeddedResource Include="..\..\data\catalog\cards.v0.107.1.json" LogicalName="cards.json" />
    <EmbeddedResource Include="..\..\data\catalog\card-pools.v0.107.1.json" LogicalName="card-pools.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sts2Overlay.GameState.Tests" />
  </ItemGroup>
</Project>
