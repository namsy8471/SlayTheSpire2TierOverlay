<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Reads game state WITHOUT a mod: save files (current_run*.save) + godot.log, and combines them
    into one live snapshot. Platform-neutral (no WPF / Win32), so it is unit-testable anywhere.
  -->
  <PropertyGroup>
    <RootNamespace>Sts2Overlay.GameState</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1573: records document only the non-obvious positional parameters. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sts2Overlay.Core\Sts2Overlay.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Names-free catalogs generated by tools/CatalogBuilder, embedded so no path lookup is needed, one set per game data
      version (Tracking/GameDataVersion.cs picks the set by the run's seed arithmetic). Resource names keep the file name,
      e.g. cards.v0.111.0.json.
      starting-decks: co-op guest decks; cards: rarity / type / keywords; card-pools: reward pool replay;
      relics: rarity + IsTradable inputs for the Relic Trader / Ranwid event checks.
    -->
    <EmbeddedResource Include="..\..\data\catalog\starting-decks.v0.107.1.json;..\..\data\catalog\starting-decks.v0.111.0.json" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\data\catalog\cards.v0.107.1.json;..\..\data\catalog\cards.v0.111.0.json" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\data\catalog\card-pools.v0.107.1.json;..\..\data\catalog\card-pools.v0.111.0.json" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\data\catalog\relics.v0.107.1.json;..\..\data\catalog\relics.v0.111.0.json" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sts2Overlay.GameState.Tests" />
  </ItemGroup>
</Project>
